<Application x:Class="Skypeek.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:Skypeek.App.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Compact UI: WPF-UI controls read their font size from this key (default 14). -->
            <system:Double x:Key="ControlContentThemeFontSize">12</system:Double>

            <!-- High-contrast text used explicitly in templates (list/tree items otherwise inherit dim colors). -->
            <SolidColorBrush x:Key="TextStrong" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextNormal" Color="#FFEDEDED" />
            <SolidColorBrush x:Key="TextMuted" Color="#FFC4C4C4" />
            <SolidColorBrush x:Key="TextDim" Color="#FF8F8F8F" />
            <SolidColorBrush x:Key="PanelBackground" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="PanelBorder" Color="#2EFFFFFF" />

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <views:LevelToBrushConverter x:Key="LevelToBrush" />
            <views:NullToCollapsedConverter x:Key="NullToCollapsed" />
            <views:CountToVisibilityConverter x:Key="CountToVisibility" />
            <views:LocalTimeConverter x:Key="LocalTime" />

            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

            <Style x:Key="LevelDot" TargetType="Ellipse">
                <Setter Property="Width" Value="9" />
                <Setter Property="Height" Value="9" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                <Setter Property="FontSize" Value="11" />
            </Style>

            <Style x:Key="Body" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextNormal}" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,10,0,4" />
                <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
            </Style>

            <Style x:Key="Badge" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="5,0" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="#33FFFFFF" />
            </Style>

            <Style x:Key="Panel" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PanelBackground}" />
                <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
