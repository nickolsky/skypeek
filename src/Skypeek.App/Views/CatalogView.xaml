<UserControl x:Class="Skypeek.App.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" MinWidth="360" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="6*" MinWidth="380" />
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:TextBox x:Name="Query" PlaceholderText="Search secrets and parameters (name, description, tags, target, region)…"
                        Icon="{ui:SymbolIcon Search24}" TextChanged="OnQueryChanged" ClearButtonEnabled="True" />

            <WrapPanel Grid.Row="1" Margin="0,8,0,6">
                <RadioButton x:Name="KindAll" Content="All" GroupName="kind" IsChecked="True" Checked="OnFilterChanged" MinWidth="60" />
                <RadioButton x:Name="KindSecrets" Content="Secrets" GroupName="kind" Checked="OnFilterChanged" MinWidth="80" />
                <RadioButton x:Name="KindParams" Content="Parameters" GroupName="kind" Checked="OnFilterChanged" MinWidth="95" Margin="0,0,8,0" />
                <ComboBox x:Name="TargetFilter" MinWidth="150" SelectionChanged="OnFilterChanged" Margin="0,0,6,0" DisplayMemberPath="Label" />
                <ComboBox x:Name="RegionFilter" MinWidth="120" SelectionChanged="OnFilterChanged" />
            </WrapPanel>

            <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="2">
                <Grid>
                    <ListView x:Name="Results" SelectionChanged="OnResultSelected" Background="Transparent" BorderThickness="0"
                              HorizontalContentAlignment="Stretch" Foreground="{StaticResource TextNormal}"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Badge}" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding KindLabel}" FontSize="10" Foreground="{StaticResource TextStrong}" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Item.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextStrong}" />
                                            <Border Style="{StaticResource Badge}" Margin="6,0,0,0" Background="#554CB86B"
                                                    Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="new" FontSize="10" Foreground="{StaticResource TextStrong}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Item.Description}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Item.Description, Converter={StaticResource NullToCollapsed}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Location}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding Modified}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               Style="{StaticResource Body}" Visibility="Collapsed" TextWrapping="Wrap" MaxWidth="420" />
                </Grid>
            </Border>

            <TextBlock x:Name="StatusText" Grid.Row="3" Margin="2,6,0,0" Style="{StaticResource Caption}" />
        </Grid>

        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

        <ContentControl x:Name="DetailsHost" Grid.Column="2" />
    </Grid>
</UserControl>
