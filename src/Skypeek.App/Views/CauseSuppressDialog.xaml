<ui:FluentWindow x:Class="Skypeek.App.Views.CauseSuppressDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Suppress health cause" Width="560" SizeToContent="Height" ResizeMode="NoResize" FontSize="12"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <StackPanel>
        <ui:TitleBar Title="Suppress health cause" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Margin="18,2,18,18">
            <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap"
                       Text="A suppressed cause stays visible (greyed out) but no longer makes the environment unhealthy. If every cause of a Red/Yellow status is suppressed, the environment counts as OK unless something else is wrong (failed deploy, error events, thresholds, alarms)." />
            <TextBlock Text="Cause text or pattern (* and ? wildcards; spacing and line breaks are ignored)" Style="{StaticResource Caption}" Margin="0,12,0,4" />
            <TextBox x:Name="Pattern" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="54" />
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Tip: replace the changing part with *, e.g. One or more TargetGroups * reduced health state:*" />
            <TextBlock Text="Scope" Style="{StaticResource Caption}" Margin="0,12,0,4" />
            <RadioButton x:Name="ThisEnv" GroupName="scope" IsChecked="True" />
            <RadioButton x:Name="ThisTarget" GroupName="scope" />
            <RadioButton x:Name="AllTargets" GroupName="scope" Content="All targets" />
            <TextBlock x:Name="Error" Foreground="#FFFF7B7F" Visibility="Collapsed" Margin="0,8,0,0" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Content="Cancel" Margin="0,0,8,0" IsCancel="True" Click="OnCancel" />
                <ui:Button Content="Suppress" Appearance="Primary" IsDefault="True" Click="OnSave" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
