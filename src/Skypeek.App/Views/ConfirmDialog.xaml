<Window x:Class="Skypeek.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Skypeek" Width="420" SizeToContent="Height" ResizeMode="NoResize" FontSize="12"
        WindowStyle="None" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#FF2B2B2B" BorderBrush="#FF3D3D3D" BorderThickness="1">
    <!-- A plain window styled like the Windows 11 content dialog: FluentWindow's Mica backdrop tinted it with the
         wallpaper and SizeToContent left a large empty area under the buttons. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="34">
            <TextBlock Text="Skypeek" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="16,0,0,0" />
            <ui:Button x:Name="CloseButton" HorizontalAlignment="Right" VerticalAlignment="Top" Width="44" Height="32"
                       Padding="0" Appearance="Transparent" BorderThickness="0" Icon="{ui:SymbolIcon Dismiss16}"
                       WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCancel" ToolTip="Close" />
        </Grid>

        <Border DockPanel.Dock="Bottom" Background="#FF202020" BorderBrush="#FF3D3D3D" BorderThickness="0,1,0,0" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button x:Name="OkButton" Grid.Column="0" Content="OK" HorizontalAlignment="Stretch" Appearance="Primary" IsDefault="True" Click="OnOk" />
                <ui:Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" HorizontalAlignment="Stretch" IsCancel="True" Click="OnCancel" />
            </Grid>
        </Border>

        <StackPanel Margin="20,4,20,22">
            <TextBlock x:Name="HeadingText" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="18" />
        </StackPanel>
    </DockPanel>
</Window>
