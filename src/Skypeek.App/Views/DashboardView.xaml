<UserControl x:Class="Skypeek.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:Skypeek.App.Views"
             xmlns:models="clr-namespace:Skypeek.Core.Models;assembly=Skypeek.Core">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Width" Value="110" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- "Hide" / "Unhide" for a resource's details (DataContext is the resource). -->
        <Style x:Key="HideButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Content" Value="Hide" />
            <Setter Property="Icon" Value="{ui:SymbolIcon EyeOff24}" />
            <Setter Property="ToolTip" Value="Hide from the dashboard: not shown, not counted as a problem, no toasts or metric queries" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter Property="Content" Value="Unhide" />
                    <Setter Property="Icon" Value="{ui:SymbolIcon Eye24}" />
                    <Setter Property="ToolTip" Value="Show this resource on the dashboard again" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Alarm list used inside resource details. -->
        <DataTemplate x:Key="AlarmRows">
            <ItemsControl ItemsSource="{Binding Alarms}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,2">
                            <ui:Button DockPanel.Dock="Right" Content="Suppress…" Padding="6,1" Click="OnSuppressAlarm" Tag="{Binding}"
                                       Visibility="{Binding Suppressed, Converter={StaticResource InverseBoolToVisibility}}" />
                            <Border Style="{StaticResource Badge}" DockPanel.Dock="Left">
                                <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="{StaticResource TextStrong}" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding StateReason}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <!-- ============ details panel templates (picked by payload type) ============ -->
        <DataTemplate DataType="{x:Type views:SsoSignInDetail}">
            <StackPanel>
                <TextBlock Text="{Binding Text}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,6,0,8"
                           Text="This profile signs in through AWS IAM Identity Center (SSO). Refreshes for it are paused and resume automatically as soon as you sign in again; nothing is sent to AWS until then." />
                <WrapPanel Margin="0,0,0,6">
                    <ui:Button Content="Sign in" Icon="{ui:SymbolIcon PersonKey20}" Appearance="Primary" Click="OnSsoSignIn" Margin="0,0,6,4"
                               ToolTip="Runs aws sso login in a console window; approve the sign-in in your browser" />
                    <ui:Button Content="Copy command" Icon="{ui:SymbolIcon Copy24}" Click="OnCopyText" Tag="{Binding Command}" Margin="0,0,6,4" />
                </WrapPanel>
                <TextBlock Text="{Binding Command}" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type views:MessageDetail}">
            <TextBlock Text="{Binding Text}" Style="{StaticResource Body}" TextWrapping="Wrap" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type views:TargetDetail}">
            <StackPanel>
                <TextBlock Text="{Binding Target.DisplayName}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}account {0} · {1}">
                            <Binding Path="Account" TargetNullValue="?" />
                            <Binding Path="Target.Region" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <WrapPanel Margin="0,0,0,8">
                    <ui:Button Content="Refresh everything" Icon="{ui:SymbolIcon ArrowSync24}" Click="OnRefreshTarget" Tag="{Binding Target.Id}" Margin="0,0,6,0" />
                </WrapPanel>
                <TextBlock Text="Keys" Style="{StaticResource SectionHeader}" />
                <StackPanel Orientation="Horizontal"><TextBlock Text="Read-only" Style="{StaticResource Label}" /><TextBlock Text="{Binding ReadOnlyProfile}" Style="{StaticResource Value}" FontFamily="{StaticResource MonoFont}" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="110,0,0,4"><TextBlock Text="{Binding ReadOnlyState}" Style="{StaticResource Caption}" TextWrapping="Wrap" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Elevated" Style="{StaticResource Label}" /><TextBlock Text="{Binding ElevatedProfile, TargetNullValue='(none — set in Settings)'}" Style="{StaticResource Value}" FontFamily="{StaticResource MonoFont}" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="110,0,0,4"><TextBlock Text="{Binding ElevatedState}" Style="{StaticResource Caption}" TextWrapping="Wrap" /></StackPanel>
                <TextBlock Text="Schedules" Style="{StaticResource SectionHeader}" />
                <StackPanel Orientation="Horizontal"><TextBlock Text="Lists" Style="{StaticResource Label}" /><TextBlock Text="{Binding Catalog}" Style="{StaticResource Value}" MaxWidth="520" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Network" Style="{StaticResource Label}" /><TextBlock Text="{Binding Network}" Style="{StaticResource Value}" MaxWidth="520" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Health" Style="{StaticResource Label}" /><TextBlock Text="{Binding Health}" Style="{StaticResource Value}" MaxWidth="520" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Metrics &amp; alarms" Style="{StaticResource Label}" /><TextBlock Text="{Binding Metrics}" Style="{StaticResource Value}" MaxWidth="520" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Metrics cost" Style="{StaticResource Label}" /><TextBlock Text="{Binding Cost, TargetNullValue='—'}" Style="{StaticResource Value}" /></StackPanel>
                <TextBlock Text="{Binding Errors}" Foreground="#FFFF7B7F" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding Errors, Converter={StaticResource NullToCollapsed}}" />

                <StackPanel Visibility="{Binding ShowCosts, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel Margin="0,12,0,2">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button Content="Refresh costs" Icon="{ui:SymbolIcon ArrowClockwise24}" Padding="8,2" Margin="0,0,6,0" Click="OnRefreshCosts" Tag="{Binding Target.Id}"
                                       ToolTip="Reads missing prices, and billed costs from Cost Explorer if enabled ($0.01 per Cost Explorer request)" />
                            <ui:Button Content="Cost Explorer" Icon="{ui:SymbolIcon Open24}" Padding="8,2" Click="OnOpenCostExplorer" />
                        </StackPanel>
                        <TextBlock Text="Monthly cost" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Updates" Style="{StaticResource Label}" /><TextBlock Text="{Binding Costs}" Style="{StaticResource Value}" MaxWidth="520" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding Estimated, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="Estimated" Style="{StaticResource Label}" /><TextBlock Text="{Binding Estimated}" Style="{StaticResource Value}" MaxWidth="520" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding Billed, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="Billed" Style="{StaticResource Label}" /><TextBlock Text="{Binding Billed}" Style="{StaticResource Value}" MaxWidth="520" /></StackPanel>
                    <ItemsControl ItemsSource="{Binding Services}" Margin="110,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Service}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Service}" />
                                    <TextBlock Grid.Column="1" Text="{Binding MonthToDate, StringFormat=${0:N2}}" Style="{StaticResource Body}" TextAlignment="Right" ToolTip="This month so far" />
                                    <TextBlock Grid.Column="2" Text="{Binding LastMonth, StringFormat=${0:N2}}" Style="{StaticResource Caption}" TextAlignment="Right" ToolTip="Last month" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding CostNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding CostNote, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type views:ClusterDetail}">
            <StackPanel>
                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}ECS cluster · {0} · {1} service(s), {2} with problems">
                            <Binding Path="Target" />
                            <Binding Path="Services" />
                            <Binding Path="Problems" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding ProblemServices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,3">
                                <TextBlock Text="{Binding Snapshot.ServiceName}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ReasonText}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:EbEnvironmentStatus}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource LevelDot}" Fill="{Binding Level, Converter={StaticResource LevelToBrush}}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Snapshot.EnvironmentName}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="17,0,0,6">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}Elastic Beanstalk · {0} · {1} · {2}">
                            <Binding Path="Snapshot.ApplicationName" />
                            <Binding Path="TargetName" />
                            <Binding Path="RefreshedText" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <WrapPanel Margin="0,0,0,6">
                    <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="OnRefreshResource" Margin="0,0,6,4"
                               ToolTip="Re-read this resource and its CPU/memory from AWS now" />
                    <ui:Button Content="View logs" Icon="{ui:SymbolIcon DocumentText24}" Appearance="Primary" Click="OnViewLogs" Margin="0,0,6,4" />
                    <ui:Button Content="Application versions" Icon="{ui:SymbolIcon Tag24}" Click="OnShowApplication" Margin="0,0,6,4"
                               ToolTip="All versions of this environment's application and where each one runs" />
                    <ui:Button Content="Open in console" Icon="{ui:SymbolIcon Open24}" Click="OnOpenConsole" Margin="0,0,6,4" />
                    <ui:Button Content="Copy name" Icon="{ui:SymbolIcon Copy24}" Click="OnCopyResource" Margin="0,0,6,4" />
                    <ui:Button Content="Thresholds…" Click="OnSetThresholds" Margin="0,0,6,4" />
                    <ui:Button Click="OnToggleHidden" Margin="0,0,6,4" Style="{StaticResource HideButton}" />
                </WrapPanel>
                <TextBlock Text="{Binding ReasonText}" Foreground="#FFFFB86B" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding ReasonText, Converter={StaticResource NullToCollapsed}}" />

                <!-- Version -->
                <Border Style="{StaticResource Panel}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Deployed version" Style="{StaticResource SectionHeader}" Margin="0,0,0,2" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Snapshot.VersionLabel}" Style="{StaticResource Body}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Snapshot.VersionCreated, Converter={StaticResource LocalTime}, StringFormat=· created {0:g}}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="6,0,0,0"
                                       Visibility="{Binding Snapshot.VersionCreated, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Snapshot.VersionStatus}" Margin="0,2,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                    <Setter Property="Foreground" Value="#FF6FD08C" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Snapshot.CanDeployLatest}" Value="True">
                                            <Setter Property="Foreground" Value="#FFFFB86B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <WrapPanel Margin="0,8,0,0">
                            <ui:Button Content="Deploy latest version…" Icon="{ui:SymbolIcon ArrowUpload24}" Appearance="Caution" Click="OnDeployLatest" Margin="0,0,6,4"
                                       Visibility="{Binding Snapshot.CanDeployLatest, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button Content="Redeploy current version…" Icon="{ui:SymbolIcon ArrowRepeatAll24}" Click="OnRedeploy" Margin="0,0,6,4" />
                            <ui:Button Content="Restart app servers…" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="OnRestartAppServers" Margin="0,0,6,4" />
                        </WrapPanel>
                        <TextBlock Text="These actions use the elevated key and ask for confirmation each time." Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>

                <!-- Why -->
                <Border Style="{StaticResource Panel}" Margin="0,0,0,8" Visibility="{Binding Snapshot.HasRootCause, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Why (enhanced health)" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding CauseItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <ui:Button DockPanel.Dock="Right" Content="Suppress…" Padding="6,1" Click="OnSuppressCause" Tag="{Binding}" VerticalAlignment="Top"
                                                   Visibility="{Binding Suppressed, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <ui:Button DockPanel.Dock="Right" Content="Unsuppress" Padding="6,1" Click="OnUnsuppressCause" Tag="{Binding}" VerticalAlignment="Top"
                                                   Visibility="{Binding Suppressed, Converter={StaticResource BoolToVisibility}}" />
                                        <StackPanel Opacity="{Binding Opacity}" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Text, StringFormat=• {0}}" Style="{StaticResource Body}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Rule, StringFormat=suppressed by rule: {0}}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                       Visibility="{Binding Suppressed, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Snapshot.RequestSummary, StringFormat=Requests: {0}}" Style="{StaticResource Body}" Margin="0,4,0,0"
                                   Visibility="{Binding Snapshot.RequestSummary, Converter={StaticResource NullToCollapsed}}" />
                        <TextBlock Text="For the underlying error, check the nodes and recent events below and View logs." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal"><TextBlock Text="Status / health" Style="{StaticResource Label}" />
                    <TextBlock Style="{StaticResource Value}"><TextBlock.Text><MultiBinding StringFormat="{}{0} · {1} ({2})"><Binding Path="Snapshot.Status" /><Binding Path="Snapshot.Health" /><Binding Path="Snapshot.HealthStatus" /></MultiBinding></TextBlock.Text></TextBlock></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Updated" Style="{StaticResource Label}" /><TextBlock Text="{Binding Snapshot.DateUpdated, Converter={StaticResource LocalTime}, StringFormat=g}" Style="{StaticResource Value}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="URL" Style="{StaticResource Label}" /><TextBlock Text="{Binding Snapshot.Cname}" Style="{StaticResource Value}" /></StackPanel>

                <!-- Nodes -->
                <TextBlock Text="Nodes (EC2 instances)" Style="{StaticResource SectionHeader}" />
                <ItemsControl ItemsSource="{Binding Nodes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Panel}" Padding="10,6" Margin="0,0,0,6">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <ui:Button Content="Reboot…" Padding="6,1" Margin="0,0,6,0" Click="OnRebootNode" Tag="{Binding InstanceId}" IsEnabled="{Binding IsRunning}" />
                                            <ui:Button Content="Terminate…" Padding="6,1" Appearance="Danger" Click="OnTerminateNode" Tag="{Binding InstanceId}" IsEnabled="{Binding IsRunning}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Style="{StaticResource LevelDot}" Fill="{Binding Level, Converter={StaticResource LevelToBrush}}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Caption}" Margin="17,2,0,0" TextWrapping="Wrap">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} · {1}">
                                                <Binding Path="HealthText" />
                                                <Binding Path="Detail" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Causes}" Foreground="#FFFFB86B" Margin="17,2,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding Causes, Converter={StaticResource NullToCollapsed}}" />
                                    <StackPanel Orientation="Horizontal" Margin="17,4,0,0">
                                        <TextBlock Text="CPU" Style="{StaticResource Caption}" Width="28" VerticalAlignment="Center" />
                                        <views:Sparkline Evaluation="{Binding Metric.Cpu}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Metric.Cpu.Display, FallbackValue=n/a}" Width="240" VerticalAlignment="Center" Style="{StaticResource Body}" />
                                        <TextBlock Text="Mem" Style="{StaticResource Caption}" Width="30" VerticalAlignment="Center" />
                                        <views:Sparkline Evaluation="{Binding Metric.Memory}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Metric.Memory.Display, FallbackValue=n/a (no CW agent)}" VerticalAlignment="Center" Style="{StaticResource Body}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <views:HistoryPanel Resource="{Binding}" />
                <views:CostLine Resource="{Binding}" />
                <views:UsagePanel Resource="{Binding}" />
                <TextBlock Text="Alarms" Style="{StaticResource SectionHeader}" Visibility="{Binding Alarms.Count, Converter={StaticResource CountToVisibility}}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AlarmRows}" />

                <TextBlock Text="Recent events" Style="{StaticResource SectionHeader}" />
                <ItemsControl ItemsSource="{Binding RecentEvents}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Date, Converter={StaticResource LocalTime}, StringFormat=g}" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Column="1" Text="{Binding Severity}" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Column="2" Text="{Binding Message}" Style="{StaticResource Body}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- All suppression rules (alarms and EB causes), opened from the toolbar. -->
        <DataTemplate DataType="{x:Type views:SuppressionsDetail}">
            <StackPanel>
                <TextBlock Text="Suppressions" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,8"
                           Text="Suppressed items stay visible (greyed out) but never count as problems, turn the tray icon red or notify." />
                <TextBlock Text="{Binding TargetTracking}" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,6" />
                <TextBlock Text="Alarms" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="No alarm rules." Style="{StaticResource Caption}" Visibility="{Binding Alarms.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />
                <ItemsControl ItemsSource="{Binding Alarms}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <ui:Button DockPanel.Dock="Right" Content="Remove" Padding="6,1" Click="OnRemoveSuppression" Tag="{Binding}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Pattern}" Style="{StaticResource Body}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Scope}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Hidden from the dashboard" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="Nothing hidden. Right-click an item in the tree, or use Hide on its details, to hide it." Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Visibility="{Binding Hidden.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />
                <ItemsControl ItemsSource="{Binding Hidden}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <ui:Button DockPanel.Dock="Right" Content="Unhide" Padding="6,1" Click="OnUnhideRow" Tag="{Binding}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Scope}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Health causes (Elastic Beanstalk, load balancer target groups)" Style="{StaticResource SectionHeader}" />
                <ItemsControl ItemsSource="{Binding Causes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <ui:Button DockPanel.Dock="Right" Content="Remove" Padding="6,1" Click="OnRemoveSuppression" Tag="{Binding}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Pattern}" Style="{StaticResource Body}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Scope}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:EcsServiceStatus}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource LevelDot}" Fill="{Binding Level, Converter={StaticResource LevelToBrush}}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Snapshot.ServiceName}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="17,0,0,6">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}ECS service · cluster {0} · {1} · {2}">
                            <Binding Path="Snapshot.ClusterName" />
                            <Binding Path="TargetName" />
                            <Binding Path="RefreshedText" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <WrapPanel Margin="0,0,0,6">
                    <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="OnRefreshResource" Margin="0,0,6,4"
                               ToolTip="Re-read this resource and its CPU/memory from AWS now" />
                    <ui:Button Content="View logs" Icon="{ui:SymbolIcon DocumentText24}" Appearance="Primary" Click="OnViewLogs" Margin="0,0,6,4" />
                    <ui:Button Content="Open in console" Icon="{ui:SymbolIcon Open24}" Click="OnOpenConsole" Margin="0,0,6,4" />
                    <ui:Button Content="Copy name" Icon="{ui:SymbolIcon Copy24}" Click="OnCopyResource" Margin="0,0,6,4" />
                    <ui:Button Content="Thresholds…" Click="OnSetThresholds" Margin="0,0,6,4" />
                    <ui:Button Click="OnToggleHidden" Margin="0,0,6,4" Style="{StaticResource HideButton}" />
                </WrapPanel>
                <TextBlock Text="{Binding ReasonText}" Foreground="#FFFFB86B" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding ReasonText, Converter={StaticResource NullToCollapsed}}" />
                <StackPanel Orientation="Horizontal"><TextBlock Text="Tasks" Style="{StaticResource Label}" />
                    <TextBlock Style="{StaticResource Value}"><TextBlock.Text><MultiBinding StringFormat="{}{0} running / {1} desired / {2} pending"><Binding Path="Snapshot.Running" /><Binding Path="Snapshot.Desired" /><Binding Path="Snapshot.Pending" /></MultiBinding></TextBlock.Text></TextBlock></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="CPU" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    <views:Sparkline Evaluation="{Binding Cpu}" Margin="0,0,8,0" /><TextBlock Text="{Binding CpuDisplay}" Style="{StaticResource Value}" VerticalAlignment="Center" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="Memory" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    <views:Sparkline Evaluation="{Binding Memory}" Margin="0,0,8,0" /><TextBlock Text="{Binding MemoryDisplay}" Style="{StaticResource Value}" VerticalAlignment="Center" /></StackPanel>

                <TextBlock Text="Deployments" Style="{StaticResource SectionHeader}" />
                <ItemsControl ItemsSource="{Binding Snapshot.Deployments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Style="{StaticResource Body}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} · {1} · {2} · running {3}, failed {4} · started {5:g}">
                                            <Binding Path="Status" />
                                            <Binding Path="RolloutState" />
                                            <Binding Path="TaskDefinition" />
                                            <Binding Path="Running" />
                                            <Binding Path="Failed" />
                                            <Binding Path="CreatedAt" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Text="{Binding RolloutStateReason}" Style="{StaticResource Caption}" TextWrapping="Wrap" Visibility="{Binding RolloutStateReason, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel Margin="0,6,0,0">
                    <ui:Button Content="Force new deployment…" Icon="{ui:SymbolIcon ArrowRepeatAll24}" Appearance="Caution" Click="OnForceNewDeployment" Margin="0,0,8,4"
                               ToolTip="Replace all tasks with fresh ones from the current task definition" />
                    <TextBlock Text="Uses the elevated key and asks for confirmation each time." Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </WrapPanel>

                <TextBlock Text="Stopped tasks" Style="{StaticResource SectionHeader}" Visibility="{Binding StoppedReasons.Count, Converter={StaticResource CountToVisibility}}" />
                <ItemsControl ItemsSource="{Binding StoppedReasons}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,1" /></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <views:HistoryPanel Resource="{Binding}" />
                <views:CostLine Resource="{Binding}" />
                <views:UsagePanel Resource="{Binding}" />
                <TextBlock Text="Alarms" Style="{StaticResource SectionHeader}" Visibility="{Binding Alarms.Count, Converter={StaticResource CountToVisibility}}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AlarmRows}" />

                <TextBlock Text="Service events" Style="{StaticResource SectionHeader}" />
                <ItemsControl ItemsSource="{Binding Snapshot.Events}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,1" /></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type views:AlarmDetail}">
            <StackPanel>
                <TextBlock Text="{Binding Alarm.Name}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Alarm.Badge}" Style="{StaticResource Caption}" Margin="0,2,0,8" />
                <WrapPanel Margin="0,0,0,8">
                    <ui:Button Content="Open in console" Icon="{ui:SymbolIcon Open24}" Click="OnOpenAlarm" Margin="0,0,6,4" />
                    <ui:Button Content="Suppress…" Icon="{ui:SymbolIcon AlertOff24}" Click="OnSuppressAlarmDetail" Margin="0,0,6,4"
                               Visibility="{Binding CanSuppress, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Content="Remove suppression" Icon="{ui:SymbolIcon Alert24}" Click="OnUnsuppressAlarm" Margin="0,0,6,4"
                               Visibility="{Binding CanUnsuppress, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>
                <TextBlock Text="{Binding Alarm.SuppressedReason}" Foreground="#FFFFB86B" TextWrapping="Wrap" Margin="0,0,0,6"
                           Visibility="{Binding Alarm.SuppressedReason, Converter={StaticResource NullToCollapsed}}" />
                <StackPanel Orientation="Horizontal"><TextBlock Text="Resource" Style="{StaticResource Label}" /><TextBlock Text="{Binding Resource, TargetNullValue='(not matched to a service)'}" Style="{StaticResource Value}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Metric" Style="{StaticResource Label}" /><TextBlock Text="{Binding Metric}" Style="{StaticResource Value}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Dimensions" Style="{StaticResource Label}" /><TextBlock Text="{Binding Dimensions}" Style="{StaticResource Value}" MaxWidth="520" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="State since" Style="{StaticResource Label}" /><TextBlock Text="{Binding Alarm.StateUpdated, Converter={StaticResource LocalTime}, StringFormat=g}" Style="{StaticResource Value}" /></StackPanel>
                <TextBlock Text="Reason" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="{Binding Alarm.StateReason}" Style="{StaticResource Body}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Alarm.RecentAlarmSummary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </DataTemplate>
        <!-- Recent RDS / ElastiCache events. -->
        <DataTemplate x:Key="ServiceEventRows">
            <StackPanel>
                <TextBlock Text="None in the last day." Style="{StaticResource Caption}"
                           Visibility="{Binding RecentEvents.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />
                <ItemsControl ItemsSource="{Binding RecentEvents}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Text}" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,1" /></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- ============ RDS instance ============ -->
        <DataTemplate DataType="{x:Type models:RdsInstanceStatus}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource LevelDot}" Fill="{Binding Level, Converter={StaticResource LevelToBrush}}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Snapshot.Identifier}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="17,0,0,6" TextWrapping="Wrap">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}RDS {0} · {1} · {2} · {3} · {4}">
                            <Binding Path="Snapshot.Role" />
                            <Binding Path="Snapshot.EngineText" />
                            <Binding Path="Snapshot.InstanceClass" />
                            <Binding Path="TargetName" />
                            <Binding Path="RefreshedText" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <WrapPanel Margin="0,0,0,6">
                    <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="OnRefreshResource" Margin="0,0,6,4"
                               ToolTip="Re-read this database and its metrics from AWS now" />
                    <ui:Button Content="View logs" Icon="{ui:SymbolIcon DocumentText24}" Appearance="Primary" Click="OnViewLogs" Margin="0,0,6,4" />
                    <ui:Button Content="Copy host" Icon="{ui:SymbolIcon Copy24}" Click="OnCopyText" Tag="{Binding Snapshot.Address}" Margin="0,0,6,4" />
                    <ui:Button Content="Open in console" Icon="{ui:SymbolIcon Open24}" Click="OnOpenConsole" Margin="0,0,6,4" />
                    <ui:Button Content="Thresholds…" Click="OnSetThresholds" Margin="0,0,6,4" />
                    <ui:Button Click="OnToggleHidden" Margin="0,0,6,4" Style="{StaticResource HideButton}" />
                </WrapPanel>
                <TextBlock Text="{Binding ReasonText}" Foreground="#FFFFB86B" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding ReasonText, Converter={StaticResource NullToCollapsed}}" />

                <Border Style="{StaticResource Panel}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Connect" Style="{StaticResource SectionHeader}" Margin="0,0,0,2" />
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Content="Copy" Padding="6,1" Click="OnCopyText" Tag="{Binding Snapshot.Address}" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding Snapshot.Endpoint}" Style="{StaticResource Body}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Margin="0,0,8,0" />
                        </DockPanel>
                        <TextBlock Text="{Binding Snapshot.ClusterIdentifier, StringFormat='Member of cluster {0}: prefer the cluster writer or reader endpoint.'}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Margin="0,4,0,0" Visibility="{Binding Snapshot.ClusterIdentifier, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal"><TextBlock Text="Status" Style="{StaticResource Label}" /><TextBlock Text="{Binding Snapshot.Status}" Style="{StaticResource Value}" /></StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding Snapshot.ReplicaSource, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="Replica of" Style="{StaticResource Label}" /><TextBlock Text="{Binding Snapshot.ReplicaSource}" Style="{StaticResource Value}" FontFamily="{StaticResource MonoFont}" MaxWidth="520" /></StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding Snapshot.ReplicationState, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="Replication" Style="{StaticResource Label}" /><TextBlock Text="{Binding Snapshot.ReplicationState}" Style="{StaticResource Value}" MaxWidth="520" /></StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding ReplicaLagText, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="Replica lag" Style="{StaticResource Label}" /><TextBlock Text="{Binding ReplicaLagText}" Style="{StaticResource Value}" /></StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding Snapshot.Replicas.Count, Converter={StaticResource CountToVisibility}}">
                    <TextBlock Text="Read replicas" Style="{StaticResource Label}" />
                    <ItemsControl ItemsSource="{Binding Snapshot.Replicas}">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Value}" FontFamily="{StaticResource MonoFont}" MaxWidth="520" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Availability" Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding Snapshot.AvailabilityText}" Style="{StaticResource Value}" MaxWidth="520" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Parameters" Style="{StaticResource Label}" />
                    <TextBlock Style="{StaticResource Value}" MaxWidth="520"><TextBlock.Text><MultiBinding StringFormat="{}{0} ({1})"><Binding Path="Snapshot.ParameterGroup" /><Binding Path="Snapshot.ParameterApplyStatus" /></MultiBinding></TextBlock.Text></TextBlock></StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding Snapshot.PendingChanges.Count, Converter={StaticResource CountToVisibility}}">
                    <TextBlock Text="Pending changes" Style="{StaticResource Label}" />
                    <ItemsControl ItemsSource="{Binding Snapshot.PendingChanges}">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Value}" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="Load" Style="{StaticResource SectionHeader}" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0"><TextBlock Text="CPU" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    <views:Sparkline Evaluation="{Binding Cpu}" Margin="0,0,8,0" /><TextBlock Text="{Binding CpuDisplay}" Style="{StaticResource Value}" VerticalAlignment="Center" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="Connections" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    <views:Sparkline Evaluation="{Binding Connections}" Margin="0,0,8,0" /><TextBlock Text="{Binding ConnectionsText}" Style="{StaticResource Value}" VerticalAlignment="Center" /></StackPanel>
                <TextBlock Text="{Binding Snapshot.MaxConnectionsSource, StringFormat=max_connections: {0}}" Style="{StaticResource Caption}" Margin="110,0,0,0"
                           Visibility="{Binding Snapshot.MaxConnectionsSource, Converter={StaticResource NullToCollapsed}}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="Storage" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    <views:UsageBar Percent="{Binding StorageUsed.Current}" Level="{Binding StorageUsed.Level}" Width="90" Height="8" Margin="0,0,8,0"
                                    Visibility="{Binding StorageUsed, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock Text="{Binding StorageText}" Style="{StaticResource Value}" VerticalAlignment="Center" /></StackPanel>
                <TextBlock Text="{Binding StorageAutoscaling}" Style="{StaticResource Caption}" Margin="110,0,0,0"
                           Visibility="{Binding StorageAutoscaling, Converter={StaticResource NullToCollapsed}}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="Memory" Style="{StaticResource Label}" /><TextBlock Text="{Binding FreeableMemoryText}" Style="{StaticResource Value}" /></StackPanel>

                <views:HistoryPanel Resource="{Binding}" />
                <views:CostLine Resource="{Binding}" />
                <views:UsagePanel Resource="{Binding}" />
                <TextBlock Text="Alarms" Style="{StaticResource SectionHeader}" Visibility="{Binding Alarms.Count, Converter={StaticResource CountToVisibility}}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AlarmRows}" />
                <TextBlock Text="Recent events" Style="{StaticResource SectionHeader}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ServiceEventRows}" />
                <TextBlock Text="Skypeek is read-only for databases: no reboot, failover or modify." Style="{StaticResource Caption}" Margin="0,8,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- ============ RDS cluster (Aurora / Multi-AZ DB cluster) ============ -->
        <DataTemplate DataType="{x:Type models:RdsClusterStatus}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource LevelDot}" Fill="{Binding Level, Converter={StaticResource LevelToBrush}}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Snapshot.Identifier}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="17,0,0,6" TextWrapping="Wrap">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}RDS cluster · {0} · {1} · {2}">
                            <Binding Path="Snapshot.EngineText" />
                            <Binding Path="TargetName" />
                            <Binding Path="RefreshedText" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <WrapPanel Margin="0,0,0,6">
                    <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="OnRefreshResource" Margin="0,0,6,4"
                               ToolTip="Re-read the cluster, its instances and their metrics now" />
                    <ui:Button Content="Copy writer host" Icon="{ui:SymbolIcon Copy24}" Click="OnCopyText" Tag="{Binding Snapshot.WriterEndpoint}" Margin="0,0,6,4" />
                    <ui:Button Content="Open in console" Icon="{ui:SymbolIcon Open24}" Click="OnOpenConsole" Margin="0,0,6,4" />
                    <ui:Button Click="OnToggleHidden" Margin="0,0,6,4" Style="{StaticResource HideButton}" />
                </WrapPanel>
                <TextBlock Text="{Binding ReasonText}" Foreground="#FFFFB86B" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding ReasonText, Converter={StaticResource NullToCollapsed}}" />

                <Border Style="{StaticResource Panel}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Connect" Style="{StaticResource SectionHeader}" Margin="0,0,0,2" />
                        <DockPanel Margin="0,2">
                            <ui:Button DockPanel.Dock="Right" Content="Copy" Padding="6,1" Click="OnCopyText" Tag="{Binding Snapshot.WriterEndpoint}" VerticalAlignment="Top" />
                            <TextBlock Text="Writer" Style="{StaticResource Label}" Width="60" />
                            <TextBlock Text="{Binding Snapshot.WriterEndpoint}" Style="{StaticResource Body}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Margin="0,0,8,0" />
                        </DockPanel>
                        <DockPanel Margin="0,2" Visibility="{Binding Snapshot.ReaderEndpoint, Converter={StaticResource NullToCollapsed}}">
                            <ui:Button DockPanel.Dock="Right" Content="Copy" Padding="6,1" Click="OnCopyText" Tag="{Binding Snapshot.ReaderEndpoint}" VerticalAlignment="Top" />
                            <TextBlock Text="Reader" Style="{StaticResource Label}" Width="60" />
                            <TextBlock Text="{Binding Snapshot.ReaderEndpoint}" Style="{StaticResource Body}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Margin="0,0,8,0" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Snapshot.CustomEndpoints}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <ui:Button DockPanel.Dock="Right" Content="Copy" Padding="6,1" Click="OnCopyText" Tag="{Binding}" VerticalAlignment="Top" />
                                        <TextBlock Text="Custom" Style="{StaticResource Caption}" Width="60" />
                                        <TextBlock Text="{Binding}" Style="{StaticResource Body}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Snapshot.Port, StringFormat=Port {0}}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal"><TextBlock Text="Status" Style="{StaticResource Label}" /><TextBlock Text="{Binding Snapshot.Status}" Style="{StaticResource Value}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Mode" Style="{StaticResource Label}" /><TextBlock Text="{Binding Snapshot.EngineMode}" Style="{StaticResource Value}" /></StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding Snapshot.ServerlessMaxAcu, Converter={StaticResource NullToCollapsed}}"><TextBlock Text="Serverless v2" Style="{StaticResource Label}" />
                    <TextBlock Style="{StaticResource Value}"><TextBlock.Text><MultiBinding StringFormat="{}{0}–{1} ACU"><Binding Path="Snapshot.ServerlessMinAcu" /><Binding Path="Snapshot.ServerlessMaxAcu" /></MultiBinding></TextBlock.Text></TextBlock></StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding Snapshot.ReplicationSource, Converter={StaticResource NullToCollapsed}}"><TextBlock Text="Replica of" Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding Snapshot.ReplicationSource}" Style="{StaticResource Value}" FontFamily="{StaticResource MonoFont}" MaxWidth="520" /></StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding Snapshot.GlobalCluster, Converter={StaticResource NullToCollapsed}}"><TextBlock Text="Global database" Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding Snapshot.GlobalCluster}" Style="{StaticResource Value}" /></StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding Snapshot.ReadReplicas.Count, Converter={StaticResource CountToVisibility}}">
                    <TextBlock Text="Replica clusters" Style="{StaticResource Label}" />
                    <ItemsControl ItemsSource="{Binding Snapshot.ReadReplicas}">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Value}" FontFamily="{StaticResource MonoFont}" MaxWidth="520" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="Instances" Style="{StaticResource SectionHeader}" />
                <ItemsControl ItemsSource="{Binding Snapshot.Members}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <TextBlock Text="{Binding InstanceId}" Style="{StaticResource Body}" FontFamily="{StaticResource MonoFont}" Width="260" TextTrimming="CharacterEllipsis" />
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                            <Setter Property="Text" Value="reader" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWriter}" Value="True"><Setter Property="Text" Value="writer" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Select an instance in the tree for its load, connections and logs." Style="{StaticResource Caption}" Margin="0,2,0,0" />

                <TextBlock Text="Alarms" Style="{StaticResource SectionHeader}" Visibility="{Binding Alarms.Count, Converter={StaticResource CountToVisibility}}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AlarmRows}" />
                <TextBlock Text="Recent events" Style="{StaticResource SectionHeader}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ServiceEventRows}" />
            </StackPanel>
        </DataTemplate>

        <!-- ============ ElastiCache ============ -->
        <DataTemplate DataType="{x:Type models:CacheStatus}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource LevelDot}" Fill="{Binding Level, Converter={StaticResource LevelToBrush}}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Snapshot.Id}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="17,0,0,6" TextWrapping="Wrap">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}ElastiCache {0} · {1} · {2} · {3} · {4}">
                            <Binding Path="Snapshot.KindText" />
                            <Binding Path="Snapshot.EngineText" />
                            <Binding Path="Snapshot.NodeType" />
                            <Binding Path="TargetName" />
                            <Binding Path="RefreshedText" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
