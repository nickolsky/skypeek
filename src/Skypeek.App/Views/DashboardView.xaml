                               ToolTip="Re-read this cache, its nodes and their metrics now" />
                    <ui:Button Content="Copy endpoint" Icon="{ui:SymbolIcon Copy24}" Appearance="Primary" Click="OnCopyText" Tag="{Binding Snapshot.MainEndpoint}" Margin="0,0,6,4" />
                    <ui:Button Content="Open in console" Icon="{ui:SymbolIcon Open24}" Click="OnOpenConsole" Margin="0,0,6,4" />
                    <ui:Button Content="Thresholds…" Click="OnSetThresholds" Margin="0,0,6,4" />
                    <ui:Button Click="OnToggleHidden" Margin="0,0,6,4" Style="{StaticResource HideButton}" />
                </WrapPanel>
                <TextBlock Text="{Binding Snapshot.Description}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding Snapshot.Description, Converter={StaticResource NullToCollapsed}}" />
                <TextBlock Text="{Binding ReasonText}" Foreground="#FFFFB86B" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding ReasonText, Converter={StaticResource NullToCollapsed}}" />

                <Border Style="{StaticResource Panel}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Connect" Style="{StaticResource SectionHeader}" Margin="0,0,0,2" />
                        <DockPanel Margin="0,2" Visibility="{Binding Snapshot.ConfigurationEndpoint, Converter={StaticResource NullToCollapsed}}">
                            <ui:Button DockPanel.Dock="Right" Content="Copy" Padding="6,1" Click="OnCopyText" Tag="{Binding Snapshot.ConfigurationEndpoint}" VerticalAlignment="Top" />
                            <TextBlock Text="Configuration" Style="{StaticResource Label}" Width="86" />
                            <TextBlock Text="{Binding Snapshot.ConfigurationEndpoint}" Style="{StaticResource Body}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Margin="0,0,8,0" />
                        </DockPanel>
                        <DockPanel Margin="0,2" Visibility="{Binding Snapshot.PrimaryEndpoint, Converter={StaticResource NullToCollapsed}}">
                            <ui:Button DockPanel.Dock="Right" Content="Copy" Padding="6,1" Click="OnCopyText" Tag="{Binding Snapshot.PrimaryEndpoint}" VerticalAlignment="Top" />
                            <TextBlock Text="Primary" Style="{StaticResource Label}" Width="86" />
                            <TextBlock Text="{Binding Snapshot.PrimaryEndpoint}" Style="{StaticResource Body}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Margin="0,0,8,0" />
                        </DockPanel>
                        <DockPanel Margin="0,2" Visibility="{Binding Snapshot.ReaderEndpoint, Converter={StaticResource NullToCollapsed}}">
                            <ui:Button DockPanel.Dock="Right" Content="Copy" Padding="6,1" Click="OnCopyText" Tag="{Binding Snapshot.ReaderEndpoint}" VerticalAlignment="Top" />
                            <TextBlock Text="Reader" Style="{StaticResource Label}" Width="86" />
                            <TextBlock Text="{Binding Snapshot.ReaderEndpoint}" Style="{StaticResource Body}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Margin="0,0,8,0" />
                        </DockPanel>
                        <TextBlock Text="{Binding Snapshot.SecurityText}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal"><TextBlock Text="Status" Style="{StaticResource Label}" /><TextBlock Text="{Binding Snapshot.Status}" Style="{StaticResource Value}" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="CPU (worst node)" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    <views:Sparkline Evaluation="{Binding Cpu}" Margin="0,0,8,0" /><TextBlock Text="{Binding CpuDisplay}" Style="{StaticResource Value}" VerticalAlignment="Center" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="Memory (worst)" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    <views:Sparkline Evaluation="{Binding Memory}" Margin="0,0,8,0" /><TextBlock Text="{Binding MemoryDisplay}" Style="{StaticResource Value}" VerticalAlignment="Center" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="Connections" Style="{StaticResource Label}" /><TextBlock Text="{Binding TotalConnections, StringFormat='{}{0:0} (all nodes)', TargetNullValue=n/a}" Style="{StaticResource Value}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Hit rate" Style="{StaticResource Label}" /><TextBlock Text="{Binding HitRate, StringFormat='{}{0:0.#}%', TargetNullValue=n/a}" Style="{StaticResource Value}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Evictions" Style="{StaticResource Label}" /><TextBlock Text="{Binding TotalEvictions, StringFormat='{}{0:0} in the last hour', TargetNullValue=n/a}" Style="{StaticResource Value}" /></StackPanel>

                <TextBlock Text="Nodes" Style="{StaticResource SectionHeader}" Visibility="{Binding NodeViews.Count, Converter={StaticResource CountToVisibility}}" />
                <ItemsControl ItemsSource="{Binding NodeViews}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Panel}" Padding="10,6" Margin="0,0,0,6">
                                <StackPanel>
                                    <DockPanel>
                                        <ui:Button DockPanel.Dock="Right" Content="Copy endpoint" Padding="6,1" Click="OnCopyText" Tag="{Binding Node.Endpoint}" />
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Style="{StaticResource LevelDot}" Fill="{Binding Level, Converter={StaticResource LevelToBrush}}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="17,2,0,0" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="17,4,0,0">
                                        <TextBlock Text="CPU" Style="{StaticResource Caption}" Width="28" VerticalAlignment="Center" />
                                        <views:Sparkline Evaluation="{Binding Metric.Cpu}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Metric.Cpu.Display, FallbackValue=n/a}" Width="240" VerticalAlignment="Center" Style="{StaticResource Body}" />
                                        <TextBlock Text="Mem" Style="{StaticResource Caption}" Width="30" VerticalAlignment="Center" />
                                        <views:Sparkline Evaluation="{Binding Metric.Memory}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Metric.Memory.Display, FallbackValue=n/a}" VerticalAlignment="Center" Style="{StaticResource Body}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <views:HistoryPanel Resource="{Binding}" />
                <views:CostLine Resource="{Binding}" />
                <views:UsagePanel Resource="{Binding}" />
                <TextBlock Text="Alarms" Style="{StaticResource SectionHeader}" Visibility="{Binding Alarms.Count, Converter={StaticResource CountToVisibility}}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AlarmRows}" />
                <TextBlock Text="Recent events" Style="{StaticResource SectionHeader}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ServiceEventRows}" />
                <TextBlock Text="Shows the AWS view of the cache; Skypeek does not connect to Redis or read keys." Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type views:CacheNodeDetail}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource LevelDot}" Fill="{Binding View.Level, Converter={StaticResource LevelToBrush}}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding View.Node.ClusterId}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="17,0,0,6" TextWrapping="Wrap">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}Cache node {0} of {1} · shard {2}">
                            <Binding Path="View.Node.NodeId" />
                            <Binding Path="Cache.Snapshot.Id" />
                            <Binding Path="View.Shard" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <WrapPanel Margin="0,0,0,6">
                    <ui:Button Content="Copy endpoint" Icon="{ui:SymbolIcon Copy24}" Click="OnCopyText" Tag="{Binding View.Node.Endpoint}" Margin="0,0,6,4" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Role" Style="{StaticResource Label}" /><TextBlock Text="{Binding View.Node.Role, TargetNullValue='—'}" Style="{StaticResource Value}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Status" Style="{StaticResource Label}" /><TextBlock Text="{Binding View.Node.Status}" Style="{StaticResource Value}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Zone" Style="{StaticResource Label}" /><TextBlock Text="{Binding View.Node.AvailabilityZone}" Style="{StaticResource Value}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Endpoint" Style="{StaticResource Label}" /><TextBlock Text="{Binding View.Node.Endpoint}" Style="{StaticResource Value}" FontFamily="{StaticResource MonoFont}" MaxWidth="520" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Created" Style="{StaticResource Label}" /><TextBlock Text="{Binding View.Node.Created, Converter={StaticResource LocalTime}, StringFormat=g}" Style="{StaticResource Value}" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="CPU" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    <views:Sparkline Evaluation="{Binding View.Metric.Cpu}" Margin="0,0,8,0" /><TextBlock Text="{Binding View.Metric.Cpu.Display, FallbackValue=n/a}" Style="{StaticResource Value}" VerticalAlignment="Center" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="Memory" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    <views:Sparkline Evaluation="{Binding View.Metric.Memory}" Margin="0,0,8,0" /><TextBlock Text="{Binding View.Metric.Memory.Display, FallbackValue=n/a}" Style="{StaticResource Value}" VerticalAlignment="Center" /></StackPanel>
                <TextBlock Text="{Binding View.Detail}" Style="{StaticResource Body}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>


        <!-- ============ ECS task / container ============ -->
        <DataTemplate DataType="{x:Type views:EcsTaskDetail}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource LevelDot}" Fill="{Binding Task.Level, Converter={StaticResource LevelToBrush}}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Task.TaskId}" FontSize="15" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextStrong}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="17,0,0,6" TextWrapping="Wrap">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}ECS task · service {0} · cluster {1} · {2}">
                            <Binding Path="Service.Snapshot.ServiceName" />
                            <Binding Path="Service.Snapshot.ClusterName" />
                            <Binding Path="Service.RefreshedText" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <WrapPanel Margin="0,0,0,6">
                    <ui:Button Content="Copy task ID" Icon="{ui:SymbolIcon Copy24}" Click="OnCopyText" Tag="{Binding Task.TaskId}" Margin="0,0,6,4" />
                    <ui:Button Content="Copy IP" Icon="{ui:SymbolIcon Copy24}" Click="OnCopyText" Tag="{Binding Task.PrivateIp}" Margin="0,0,6,4"
                               Visibility="{Binding Task.PrivateIp, Converter={StaticResource NullToCollapsed}}" />
                    <ui:Button Content="Open in console" Icon="{ui:SymbolIcon Open24}" Click="OnOpenDetailConsole" Margin="0,0,6,4" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Status" Style="{StaticResource Label}" />
                    <TextBlock Style="{StaticResource Value}"><TextBlock.Text><MultiBinding StringFormat="{}{0} (desired {1}) · health {2}"><Binding Path="Task.LastStatus" /><Binding Path="Task.DesiredStatus" /><Binding Path="Task.HealthStatus" TargetNullValue="n/a" /></MultiBinding></TextBlock.Text></TextBlock></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Task definition" Style="{StaticResource Label}" /><TextBlock Text="{Binding Task.TaskDefinition}" Style="{StaticResource Value}" FontFamily="{StaticResource MonoFont}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Started" Style="{StaticResource Label}" />
                    <TextBlock Style="{StaticResource Value}"><TextBlock.Text><MultiBinding StringFormat="{}{0:g} · {1}"><Binding Path="Task.StartedAt" Converter="{StaticResource LocalTime}" /><Binding Path="Task.Uptime" /></MultiBinding></TextBlock.Text></TextBlock></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Private IP" Style="{StaticResource Label}" /><TextBlock Text="{Binding Task.PrivateIp, TargetNullValue='—'}" Style="{StaticResource Value}" FontFamily="{StaticResource MonoFont}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Zone" Style="{StaticResource Label}" /><TextBlock Text="{Binding Task.AvailabilityZone}" Style="{StaticResource Value}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Launch" Style="{StaticResource Label}" />
                    <TextBlock Style="{StaticResource Value}"><TextBlock.Text><MultiBinding StringFormat="{}{0} {1} · {2}"><Binding Path="Task.LaunchType" TargetNullValue="" /><Binding Path="Task.CapacityProvider" TargetNullValue="" /><Binding Path="Task.SizeText" /></MultiBinding></TextBlock.Text></TextBlock></StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding Task.StartedBy, Converter={StaticResource NullToCollapsed}}"><TextBlock Text="Started by" Style="{StaticResource Label}" /><TextBlock Text="{Binding Task.StartedBy}" Style="{StaticResource Value}" FontFamily="{StaticResource MonoFont}" /></StackPanel>

                <TextBlock Text="Containers" Style="{StaticResource SectionHeader}" />
                <ItemsControl ItemsSource="{Binding Task.Containers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Panel}" Padding="10,6" Margin="0,0,0,6">
                                <StackPanel>
                                    <DockPanel>
                                        <ui:Button DockPanel.Dock="Right" Content="View logs" Padding="6,1" Click="OnViewContainerLogs" Tag="{Binding}" />
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Style="{StaticResource LevelDot}" Fill="{Binding Level, Converter={StaticResource LevelToBrush}}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Image}" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" Margin="17,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type views:EcsContainerDetail}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource LevelDot}" Fill="{Binding Container.Level, Converter={StaticResource LevelToBrush}}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Container.Name}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="17,0,0,6" TextWrapping="Wrap">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}Container · task {0} · service {1}">
                            <Binding Path="Task.TaskId" />
                            <Binding Path="Service.Snapshot.ServiceName" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <WrapPanel Margin="0,0,0,6">
                    <ui:Button Content="View logs" Icon="{ui:SymbolIcon DocumentText24}" Appearance="Primary" Click="OnViewContainerLogs" Tag="{Binding Container}" Margin="0,0,6,4" />
                    <ui:Button Content="Copy image" Icon="{ui:SymbolIcon Copy24}" Click="OnCopyText" Tag="{Binding Container.Image}" Margin="0,0,6,4" />
                    <ui:Button Content="Open task in console" Icon="{ui:SymbolIcon Open24}" Click="OnOpenDetailConsole" Margin="0,0,6,4" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Status" Style="{StaticResource Label}" /><TextBlock Text="{Binding Container.Summary}" Style="{StaticResource Value}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Image" Style="{StaticResource Label}" /><TextBlock Text="{Binding Container.Image}" Style="{StaticResource Value}" FontFamily="{StaticResource MonoFont}" MaxWidth="520" /></StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding Container.ImageDigest, Converter={StaticResource NullToCollapsed}}"><TextBlock Text="Digest" Style="{StaticResource Label}" /><TextBlock Text="{Binding Container.ImageDigest}" Style="{StaticResource Value}" FontFamily="{StaticResource MonoFont}" MaxWidth="520" /></StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding Container.RuntimeId, Converter={StaticResource NullToCollapsed}}"><TextBlock Text="Runtime ID" Style="{StaticResource Label}" /><TextBlock Text="{Binding Container.RuntimeId}" Style="{StaticResource Value}" FontFamily="{StaticResource MonoFont}" MaxWidth="520" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Reserved" Style="{StaticResource Label}" />
                    <TextBlock Style="{StaticResource Value}"><TextBlock.Text><MultiBinding StringFormat="{}CPU {0} · memory {1} MiB"><Binding Path="Container.Cpu" TargetNullValue="—" /><Binding Path="Container.Memory" TargetNullValue="—" /></MultiBinding></TextBlock.Text></TextBlock></StackPanel>
            </StackPanel>
        </DataTemplate>


        <!-- ============ EC2 ============ -->
        <DataTemplate DataType="{x:Type views:Ec2GroupDetail}">
            <StackPanel>
                <TextBlock Text="EC2 instances" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,4,0,8" />
                <CheckBox Content="Also list instances that Elastic Beanstalk manages" IsChecked="{Binding IncludeEb, Mode=OneWay}" Click="OnToggleEc2IncludeEb"
                          ToolTip="Applies to every target after the next health poll (started now)" />
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="Stopped instances are greyed out and are not problems. Right-click an item in the tree to hide it from the dashboard." />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SecurityGroupChips">
            <ItemsControl ItemsSource="{Binding}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Button Padding="6,1" Margin="0,0,6,4" Click="OnOpenSecurityGroup" Tag="{Binding Id}" ToolTip="Open this security group on the Network tab">
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} · {1}">
                                        <Binding Path="Name" />
                                        <Binding Path="Id" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </ui:Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:Ec2InstanceStatus}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource LevelDot}" Fill="{Binding Level, Converter={StaticResource LevelToBrush}}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Snapshot.Title}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="17,0,0,6" TextWrapping="Wrap">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}EC2 {0} · {1} · {2} · {3} · {4}">
                            <Binding Path="Snapshot.InstanceId" />
                            <Binding Path="Snapshot.InstanceType" />
                            <Binding Path="Snapshot.State" />
                            <Binding Path="TargetName" />
                            <Binding Path="RefreshedText" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <WrapPanel Margin="0,0,0,6">
                    <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="OnRefreshResource" Margin="0,0,6,4"
                               ToolTip="Re-read this instance, its status checks and CPU/memory now" />
                    <ui:Button Content="Open in console" Icon="{ui:SymbolIcon Open24}" Click="OnOpenConsole" Margin="0,0,6,4" />
                    <ui:Button Content="Copy ID" Icon="{ui:SymbolIcon Copy24}" Click="OnCopyText" Tag="{Binding Snapshot.InstanceId}" Margin="0,0,6,4" />
                    <ui:Button Content="Copy private IP" Icon="{ui:SymbolIcon Copy24}" Click="OnCopyText" Tag="{Binding Snapshot.PrivateIp}" Margin="0,0,6,4"
                               Visibility="{Binding Snapshot.PrivateIp, Converter={StaticResource NullToCollapsed}}" />
                    <ui:Button Content="Copy public IP" Icon="{ui:SymbolIcon Copy24}" Click="OnCopyText" Tag="{Binding Snapshot.PublicIp}" Margin="0,0,6,4"
                               Visibility="{Binding Snapshot.PublicIp, Converter={StaticResource NullToCollapsed}}" />
                    <ui:Button Content="Thresholds…" Click="OnSetThresholds" Margin="0,0,6,4" />
                    <ui:Button Click="OnToggleHidden" Margin="0,0,6,4" Style="{StaticResource HideButton}" />
                </WrapPanel>
                <TextBlock Text="{Binding ReasonText}" Foreground="#FFFFB86B" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding ReasonText, Converter={StaticResource NullToCollapsed}}" />

                <Border Style="{StaticResource Panel}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Power" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                        <WrapPanel>
                            <ui:Button Content="Start…" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" Click="OnStartInstance" Margin="0,0,6,4"
                                       Visibility="{Binding Snapshot.CanStart, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button Content="Reboot…" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="OnRebootInstance" Margin="0,0,6,4" IsEnabled="{Binding Snapshot.CanReboot}" />
                            <ui:Button Content="Stop…" Icon="{ui:SymbolIcon Stop24}" Appearance="Caution" Click="OnStopInstance" Margin="0,0,6,4" IsEnabled="{Binding Snapshot.CanStop}" />
                        </WrapPanel>
                        <TextBlock Text="Uses the elevated key and asks for confirmation each time; stopping asks you to type the instance ID." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal"><TextBlock Text="State" Style="{StaticResource Label}" />
                    <TextBlock Style="{StaticResource Value}" MaxWidth="520"><TextBlock.Text><MultiBinding StringFormat="{}{0} {1}"><Binding Path="Snapshot.State" /><Binding Path="Snapshot.StateReason" TargetNullValue="" /></MultiBinding></TextBlock.Text></TextBlock></StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding Snapshot.OwnerText, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="Managed by" Style="{StaticResource Label}" /><TextBlock Text="{Binding Snapshot.OwnerText}" Style="{StaticResource Value}" MaxWidth="520" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Status checks" Style="{StaticResource Label}" /><TextBlock Text="{Binding Snapshot.ChecksText}" Style="{StaticResource Value}" MaxWidth="520" /></StackPanel>
                <ItemsControl ItemsSource="{Binding Snapshot.StatusDetails}" Margin="110,0,0,0">
                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Caption}" Foreground="#FFFFB86B" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Visibility="{Binding Snapshot.ScheduledEvents.Count, Converter={StaticResource CountToVisibility}}">
                    <TextBlock Text="Scheduled" Style="{StaticResource Label}" />
                    <ItemsControl ItemsSource="{Binding Snapshot.ScheduledEvents}">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Value}" Foreground="#FFFFB86B" MaxWidth="520" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Launched" Style="{StaticResource Label}" /><TextBlock Text="{Binding Snapshot.LaunchTime, Converter={StaticResource LocalTime}, StringFormat=g}" Style="{StaticResource Value}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Zone" Style="{StaticResource Label}" /><TextBlock Text="{Binding Snapshot.AvailabilityZone}" Style="{StaticResource Value}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="VPC / subnet" Style="{StaticResource Label}" />
                    <TextBlock Style="{StaticResource Value}" FontFamily="{StaticResource MonoFont}" MaxWidth="520"><TextBlock.Text><MultiBinding StringFormat="{}{0} / {1}"><Binding Path="Snapshot.VpcId" TargetNullValue="—" /><Binding Path="Snapshot.SubnetId" TargetNullValue="—" /></MultiBinding></TextBlock.Text></TextBlock></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Platform" Style="{StaticResource Label}" /><TextBlock Text="{Binding Snapshot.Platform}" Style="{StaticResource Value}" MaxWidth="520" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Image" Style="{StaticResource Label}" /><TextBlock Text="{Binding Snapshot.ImageId}" Style="{StaticResource Value}" FontFamily="{StaticResource MonoFont}" /></StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding Snapshot.IamInstanceProfile, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="IAM profile" Style="{StaticResource Label}" /><TextBlock Text="{Binding Snapshot.IamInstanceProfile}" Style="{StaticResource Value}" MaxWidth="520" /></StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding Snapshot.KeyName, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="Key pair" Style="{StaticResource Label}" /><TextBlock Text="{Binding Snapshot.KeyName}" Style="{StaticResource Value}" /></StackPanel>

                <TextBlock Text="Addresses" Style="{StaticResource SectionHeader}" />
                <StackPanel Orientation="Horizontal"><TextBlock Text="Private" Style="{StaticResource Label}" />
                    <TextBlock Style="{StaticResource Value}" FontFamily="{StaticResource MonoFont}" MaxWidth="520"><TextBlock.Text><MultiBinding StringFormat="{}{0}  {1}"><Binding Path="Snapshot.PrivateIp" TargetNullValue="—" /><Binding Path="Snapshot.PrivateDns" TargetNullValue="" /></MultiBinding></TextBlock.Text></TextBlock></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Public" Style="{StaticResource Label}" />
                    <TextBlock Style="{StaticResource Value}" FontFamily="{StaticResource MonoFont}" MaxWidth="520"><TextBlock.Text><MultiBinding StringFormat="{}{0}  {1}"><Binding Path="Snapshot.PublicIp" TargetNullValue="none" /><Binding Path="Snapshot.PublicDns" TargetNullValue="" /></MultiBinding></TextBlock.Text></TextBlock></StackPanel>
                <ItemsControl ItemsSource="{Binding Snapshot.Interfaces}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Panel}" Padding="10,6" Margin="0,0,0,6">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Id}" Style="{StaticResource Body}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DeviceIndex, StringFormat=device {0}}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Margin="0,2,0,4" />
                                    <ContentPresenter Content="{Binding SecurityGroups}" ContentTemplate="{StaticResource SecurityGroupChips}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Security groups" Style="{StaticResource SectionHeader}" />
                <ContentPresenter Content="{Binding Snapshot.SecurityGroups}" ContentTemplate="{StaticResource SecurityGroupChips}" />

                <TextBlock Text="Load" Style="{StaticResource SectionHeader}" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0"><TextBlock Text="CPU" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    <views:Sparkline Evaluation="{Binding Cpu}" Margin="0,0,8,0" /><TextBlock Text="{Binding CpuDisplay}" Style="{StaticResource Value}" VerticalAlignment="Center" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="Memory" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    <views:Sparkline Evaluation="{Binding Memory}" Margin="0,0,8,0" /><TextBlock Text="{Binding Memory.Display, FallbackValue=n/a (no CloudWatch agent)}" Style="{StaticResource Value}" VerticalAlignment="Center" /></StackPanel>

                <views:HistoryPanel Resource="{Binding}" />
                <views:CostLine Resource="{Binding}" />
                <views:UsagePanel Resource="{Binding}" />
                <TextBlock Text="Alarms" Style="{StaticResource SectionHeader}" Visibility="{Binding Alarms.Count, Converter={StaticResource CountToVisibility}}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AlarmRows}" />
            </StackPanel>
        </DataTemplate>

        <!-- ============ Load balancers ============ -->
        <DataTemplate DataType="{x:Type models:LoadBalancerStatus}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource LevelDot}" Fill="{Binding Level, Converter={StaticResource LevelToBrush}}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Snapshot.Name}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="17,0,0,6" TextWrapping="Wrap">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} · {1} · {2} · {3} · {4}">
                            <Binding Path="Snapshot.TypeText" />
                            <Binding Path="Snapshot.Scheme" />
                            <Binding Path="Snapshot.State" />
                            <Binding Path="TargetName" />
                            <Binding Path="RefreshedText" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <WrapPanel Margin="0,0,0,6">
                    <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="OnRefreshResource" Margin="0,0,6,4"
                               ToolTip="Re-read this load balancer and its target health now" />
                    <ui:Button Content="Manage in console" Icon="{ui:SymbolIcon Open24}" Appearance="Primary" Click="OnOpenConsole" Margin="0,0,6,4" />
                    <ui:Button Content="Copy DNS name" Icon="{ui:SymbolIcon Copy24}" Click="OnCopyText" Tag="{Binding Snapshot.DnsName}" Margin="0,0,6,4" />
                    <ui:Button Click="OnToggleHidden" Margin="0,0,6,4" Style="{StaticResource HideButton}" />
                </WrapPanel>
                <TextBlock Text="{Binding ReasonText}" Foreground="#FFFFB86B" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding ReasonText, Converter={StaticResource NullToCollapsed}}" />

                <Border Style="{StaticResource Panel}" Margin="0,0,0,8" Visibility="{Binding CauseItems.Count, Converter={StaticResource CountToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Target group problems" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding CauseItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <ui:Button DockPanel.Dock="Right" Content="Suppress…" Padding="6,1" Click="OnSuppressCause" Tag="{Binding}" VerticalAlignment="Top"
                                                   Visibility="{Binding Suppressed, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <ui:Button DockPanel.Dock="Right" Content="Unsuppress" Padding="6,1" Click="OnUnsuppressCause" Tag="{Binding}" VerticalAlignment="Top"
                                                   Visibility="{Binding Suppressed, Converter={StaticResource BoolToVisibility}}" />
                                        <StackPanel Opacity="{Binding Opacity}" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Text, StringFormat=• {0}}" Style="{StaticResource Body}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Rule, StringFormat=suppressed by rule: {0}}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                       Visibility="{Binding Suppressed, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal"><TextBlock Text="DNS name" Style="{StaticResource Label}" /><TextBlock Text="{Binding Snapshot.DnsName}" Style="{StaticResource Value}" FontFamily="{StaticResource MonoFont}" MaxWidth="520" /></StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding Snapshot.StateReason, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="State reason" Style="{StaticResource Label}" /><TextBlock Text="{Binding Snapshot.StateReason}" Style="{StaticResource Value}" MaxWidth="520" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Traffic" Style="{StaticResource Label}" /><TextBlock Text="{Binding TrafficText}" Style="{StaticResource Value}" MaxWidth="520" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="VPC" Style="{StaticResource Label}" /><TextBlock Text="{Binding Snapshot.VpcId}" Style="{StaticResource Value}" FontFamily="{StaticResource MonoFont}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="IP type" Style="{StaticResource Label}" /><TextBlock Text="{Binding Snapshot.IpAddressType}" Style="{StaticResource Value}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Zones" Style="{StaticResource Label}" />
                    <ItemsControl ItemsSource="{Binding Snapshot.Zones}">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Value}" FontFamily="{StaticResource MonoFont}" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Created" Style="{StaticResource Label}" /><TextBlock Text="{Binding Snapshot.Created, Converter={StaticResource LocalTime}, StringFormat=g}" Style="{StaticResource Value}" /></StackPanel>
                <StackPanel Visibility="{Binding Snapshot.SecurityGroups.Count, Converter={StaticResource CountToVisibility}}">
                    <TextBlock Text="Security groups" Style="{StaticResource SectionHeader}" />
                    <ItemsControl ItemsSource="{Binding Snapshot.SecurityGroups}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Button Content="{Binding}" Padding="6,1" Margin="0,0,6,4" Click="OnOpenSecurityGroup" Tag="{Binding}" ToolTip="Open this security group on the Network tab" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="Target groups" Style="{StaticResource SectionHeader}" />
                <ItemsControl ItemsSource="{Binding Snapshot.TargetGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Panel}" Padding="10,6" Margin="0,0,0,6">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource LevelDot}" Fill="{Binding Level, Converter={StaticResource LevelToBrush}}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} · {1} · {2}">
                                                    <Binding Path="ProtocolText" />
                                                    <Binding Path="TargetType" />
                                                    <Binding Path="HealthText" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{Binding UnhealthyReasons}" Style="{StaticResource Body}" Foreground="#FFFFB86B" Margin="17,2,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding UnhealthyReasons, Converter={StaticResource NullToCollapsed}}" />
                                    <TextBlock Text="{Binding HealthCheck}" Style="{StaticResource Caption}" Margin="17,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Select a target group in the tree for its targets." Style="{StaticResource Caption}" />

                <views:CostLine Resource="{Binding}" />
                <views:ListenersPanel Resource="{Binding}" />
                <TextBlock Text="Alarms" Style="{StaticResource SectionHeader}" Visibility="{Binding Alarms.Count, Converter={StaticResource CountToVisibility}}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AlarmRows}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type views:TargetGroupDetail}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource LevelDot}" Fill="{Binding Group.Level, Converter={StaticResource LevelToBrush}}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Group.Name}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="17,0,0,6" TextWrapping="Wrap">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}Target group · {0} · {1} targets · of {2} · {3}">
                            <Binding Path="Group.ProtocolText" />
                            <Binding Path="Group.TargetType" />
                            <Binding Path="LoadBalancer.Snapshot.Name" />
                            <Binding Path="LoadBalancer.RefreshedText" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <WrapPanel Margin="0,0,0,6">
                    <ui:Button Content="Manage in console" Icon="{ui:SymbolIcon Open24}" Appearance="Primary" Click="OnOpenDetailConsole" Margin="0,0,6,4" />
                    <ui:Button Content="Copy ARN" Icon="{ui:SymbolIcon Copy24}" Click="OnCopyText" Tag="{Binding Group.Arn}" Margin="0,0,6,4" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Health" Style="{StaticResource Label}" /><TextBlock Text="{Binding Group.HealthText}" Style="{StaticResource Value}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Health check" Style="{StaticResource Label}" /><TextBlock Text="{Binding Group.HealthCheck}" Style="{StaticResource Value}" MaxWidth="520" /></StackPanel>
                <TextBlock Text="{Binding Group.Error, StringFormat=Could not read target health: {0}}" Foreground="#FFFF7B7F" TextWrapping="Wrap"
                           Visibility="{Binding Group.Error, Converter={StaticResource NullToCollapsed}}" />

                <TextBlock Text="Targets" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="No registered targets." Style="{StaticResource Caption}" Visibility="{Binding Targets.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />
                <ItemsControl ItemsSource="{Binding Targets}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <ui:Button DockPanel.Dock="Right" Content="Show instance" Padding="6,1" Click="OnShowInstance" Tag="{Binding Id}" VerticalAlignment="Top"
                                           Visibility="{Binding IsInstance, Converter={StaticResource BoolToVisibility}}" />
                                <Ellipse Style="{StaticResource LevelDot}" Fill="{Binding Level, Converter={StaticResource LevelToBrush}}" Margin="0,4,8,0" VerticalAlignment="Top" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- ============ Elastic Beanstalk application ============ -->
        <DataTemplate DataType="{x:Type views:EbApplicationDetail}">
            <StackPanel>
                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                <WrapPanel Margin="0,0,0,6">
                    <ui:Button Content="Reload versions" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="OnReloadVersions" Margin="0,0,6,4" />
                </WrapPanel>

                <TextBlock Text="Environments" Style="{StaticResource SectionHeader}" />
                <ItemsControl ItemsSource="{Binding Environments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Style="{StaticResource LevelDot}" Fill="{Binding Level, Converter={StaticResource LevelToBrush}}" VerticalAlignment="Top" Margin="0,4,0,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Snapshot.EnvironmentName}" Style="{StaticResource Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Snapshot.VersionLabel}" Style="{StaticResource Body}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Snapshot.VersionStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Versions" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="{Binding VersionsStatus}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding Versions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="0,4">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Version.Label}" Style="{StaticResource Body}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" />
                                        <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Background="#5530A46C" Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="{StaticResource TextStrong}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:g} · {1} · {2}">
                                                <Binding Path="Version.Created" Converter="{StaticResource LocalTime}" />
                                                <Binding Path="Version.Status" TargetNullValue="?" />
                                                <Binding Path="DeployedTo" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Version.Description}" Style="{StaticResource Body}" TextWrapping="Wrap" Visibility="{Binding Version.Description, Converter={StaticResource NullToCollapsed}}" />
                                    <TextBlock Text="{Binding Version.Source}" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Visibility="{Binding Version.Source, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel>
            <ui:Button Icon="{ui:SymbolIcon HeartPulse24}" Content="Refresh health" Click="OnRefreshHealth" Margin="0,0,6,4" />
            <ui:Button Icon="{ui:SymbolIcon DataLine24}" Content="Refresh metrics &amp; alarms" Click="OnRefreshMetrics" Margin="0,0,6,4" />
            <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Content="Refresh lists" Click="OnRefreshCatalogs" Margin="0,0,14,4" />
            <ui:TextBox x:Name="SearchBox" Width="280" Margin="0,0,10,4" PlaceholderText="Search (Ctrl+F): name, id, IP, endpoint, image…"
                        Icon="{ui:SymbolIcon Search24}" TextChanged="OnSearchChanged" KeyDown="OnSearchKeyDown" />
            <CheckBox x:Name="ProblemsOnly" Content="Problems only" Checked="OnFilterChanged" Unchecked="OnFilterChanged" Margin="0,0,10,4" />
            <CheckBox x:Name="GroupByApp" Content="EB by application" Checked="OnGroupByAppChanged" Unchecked="OnGroupByAppChanged" Margin="0,0,10,4"
                      ToolTip="Show Elastic Beanstalk environments under their application" />
            <CheckBox x:Name="ShowHidden" Content="Show hidden" Checked="OnFilterChanged" Unchecked="OnFilterChanged" Margin="0,0,10,4"
                      ToolTip="Also show resources hidden from the dashboard (dimmed, not counted)" />
            <ui:Button Content="Expand problems" Click="OnExpandProblems" Margin="0,0,6,4" />
            <ui:Button Content="Collapse all" Click="OnCollapseAll" Margin="0,0,6,4" />
            <ui:Button x:Name="SuppressionsButton" Content="Suppressions" Icon="{ui:SymbolIcon AlertOff24}" Click="OnShowSuppressions" Margin="0,0,14,4" />
            <TextBlock x:Name="Summary" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,14,0" />
            <TextBlock x:Name="ActionStatus" Style="{StaticResource Body}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="700" />
        </WrapPanel>

        <Grid Grid.Row="1" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" MinWidth="380" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="5*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Panel}" Padding="4">
                <TreeView x:Name="Tree" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextNormal}" Padding="0,0,16,14"
                          SelectedItemChanged="OnSelected" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type views:DashNode}" ItemsSource="{Binding Children}">
                            <Grid Margin="0,1" Opacity="{Binding TitleOpacity}">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Hide from dashboard" Click="OnHideNode" Visibility="{Binding CanHide, Converter={StaticResource BoolToVisibility}}" />
                                        <MenuItem Header="Unhide" Click="OnHideNode" Visibility="{Binding CanUnhide, Converter={StaticResource BoolToVisibility}}" />
                                        <MenuItem Header="Copy name" Click="OnCopyNodeTitle" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Style="{StaticResource LevelDot}" Fill="{Binding Level, Converter={StaticResource LevelToBrush}}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock x:Name="TitleText" Text="{Binding Title}" Foreground="{StaticResource TextStrong}" FontSize="12" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource Badge}" Margin="6,0,0,0" Background="#AAE8464A" Visibility="{Binding Badge, Converter={StaticResource NullToCollapsed}}">
                                        <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="{StaticResource TextStrong}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Right}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <ItemsControl ItemsSource="{Binding Gauges}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    <views:UsageBar Percent="{Binding Percent}" Level="{Binding Level}" Width="40" Height="5" Margin="0,0,5,0"
                                                                    Visibility="{Binding HasBar, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Text="{Binding Text}" Style="{StaticResource Caption}" Foreground="{StaticResource TextNormal}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="520" />
                            </Grid>
                            <HierarchicalDataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsStrong}" Value="True">
                                    <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                    <Setter TargetName="TitleText" Property="Foreground" Value="#FF60CDFF" />
                                    <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </HierarchicalDataTemplate.Triggers>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <!-- The themed scrollbar overlays content: keep a gutter for it, and no focus frame around the panel. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ContentControl x:Name="Details" Foreground="{StaticResource TextNormal}" Focusable="False" Margin="0,0,18,0">
                        <TextBlock Text="Select a target, service, environment, database, cache, instance, load balancer or alarm." Style="{StaticResource Body}" />
                    </ContentControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock x:Name="Footer" Grid.Row="2" Margin="2,6,0,0" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
