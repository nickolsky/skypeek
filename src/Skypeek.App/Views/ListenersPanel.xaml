<UserControl x:Class="Skypeek.App.Views.ListenersPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel Margin="0,4,0,4">
        <DockPanel>
            <ui:Button x:Name="ReloadButton" DockPanel.Dock="Right" Content="Reload" Icon="{ui:SymbolIcon ArrowClockwise24}" Padding="8,2"
                       Click="OnReload" VerticalAlignment="Top" />
            <TextBlock Text="Listeners and routing rules" Style="{StaticResource SectionHeader}" Margin="0,0,0,2" />
        </DockPanel>
        <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,4" />
        <ItemsControl x:Name="ListenerList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Panel}" Padding="10,6" Margin="0,0,0,6">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Rules}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Priority}" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Conditions, StringFormat=if {0}}" Style="{StaticResource Body}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Actions, StringFormat=→ {0}}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                   Text="Skypeek is read-only for load balancers; change listeners, rules and targets in the AWS console." />
    </StackPanel>
</UserControl>
