<ui:FluentWindow x:Class="Skypeek.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Skypeek"
                 Width="1400" Height="860" MinWidth="900" MinHeight="520"
                 FontSize="12"
                 Foreground="{StaticResource TextNormal}"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="TitleBarControl" Title="Skypeek" />

        <TabControl x:Name="Tabs" Grid.Row="1" Margin="12,0,12,10" SelectionChanged="OnTabChanged">
            <TabItem x:Name="DashboardTab" Header="Dashboard" />
            <TabItem x:Name="LogsTab" Header="Logs" />
            <TabItem x:Name="NetworkTab" Header="Network" />
            <TabItem x:Name="CatalogTab" Header="Secrets &amp; parameters" />
            <TabItem x:Name="LogTab" Header="Request log" />
            <TabItem x:Name="SettingsTab" Header="Settings" />
        </TabControl>

        <!-- Top-right of the tab strip. Closing the window only hides it to the tray; Exit really quits. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,14,0">
            <ui:Button Content="Lock" Icon="{ui:SymbolIcon LockClosed24}" Padding="10,4" Margin="0,0,6,0" Click="OnLock"
                       ToolTip="Hide the window and require the master password; background refresh continues" />
            <ui:Button Content="Exit" Icon="{ui:SymbolIcon Power24}" Padding="10,4" Click="OnExit"
                       ToolTip="Quit Skypeek (stops background monitoring)" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
