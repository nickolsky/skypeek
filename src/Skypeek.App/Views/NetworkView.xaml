<UserControl x:Class="Skypeek.App.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:Skypeek.App.Views">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Width" Value="110" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Security group chips (id + name) that select the group in the tree. -->
        <DataTemplate x:Key="GroupChips">
            <ItemsControl ItemsSource="{Binding}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Button Padding="6,1" Margin="0,0,6,4" Click="OnSelectGroup" Tag="{Binding Id}">
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} · {1}">
                                        <Binding Path="Name" />
                                        <Binding Path="Id" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </ui:Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <!-- Rule table for one direction. -->
        <DataTemplate x:Key="RuleRows">
            <ItemsControl ItemsSource="{Binding}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="0,4">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <ui:Button Content="Edit…" Padding="6,1" Margin="0,0,6,0" Click="OnEditRule" Tag="{Binding Rule}" />
                                    <ui:Button Content="Delete…" Padding="6,1" Appearance="Danger" Click="OnDeleteRule" Tag="{Binding Rule}" />
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Rule.ProtocolText}" Style="{StaticResource Body}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Rule.PortText}" Style="{StaticResource Body}" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <TextBlock Text="{Binding SourceText}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Rule.IsOpenToWorld}" Value="True">
                                                            <Setter Property="Foreground" Value="#FFFFB86B" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ui:Button Content="Go" Padding="4,0" Margin="6,0,0,0" FontSize="10" Click="OnSelectGroup" Tag="{Binding Rule.ReferencedGroupId}"
                                                   Visibility="{Binding IsGroupSource, Converter={StaticResource BoolToVisibility}}" ToolTip="Open the referenced security group" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Caption}" TextWrapping="Wrap">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} · {1}">
                                                <Binding Path="Rule.RuleId" />
                                                <Binding Path="Rule.Description" TargetNullValue="no description" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <!-- ============ details templates ============ -->
        <DataTemplate DataType="{x:Type views:MessageDetail}">
            <TextBlock Text="{Binding Text}" Style="{StaticResource Body}" TextWrapping="Wrap" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type views:NetworkTargetDetail}">
            <StackPanel>
                <TextBlock Text="{Binding Target.DisplayName}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                <TextBlock Text="{Binding Target.Region}" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                <WrapPanel Margin="0,0,0,8">
                    <ui:Button Content="Download now" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Primary" Click="OnDownloadTarget" Tag="{Binding Target.Id}" Margin="0,0,6,4" />
                </WrapPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Body}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="The network inventory is downloaded on its own schedule (Settings → Accounts &amp; regions) and cached in the vault, so this tab opens instantly. Searching finds IP addresses, interface and group ids, names and rule sources." />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type views:VpcDetail}">
            <StackPanel>
                <TextBlock Text="{Binding Vpc.Title}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                <TextBlock Text="{Binding Target.DisplayName, StringFormat=VPC · {0}}" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                <WrapPanel Margin="0,0,0,6">
                    <ui:Button Content="Open in console" Icon="{ui:SymbolIcon Open24}" Click="OnOpenConsole" Margin="0,0,6,4" />
                    <ui:Button Content="Copy ID" Icon="{ui:SymbolIcon Copy24}" Click="OnCopyText" Tag="{Binding Vpc.Id}" Margin="0,0,6,4" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="ID" Style="{StaticResource Label}" /><TextBlock Text="{Binding Vpc.Id}" Style="{StaticResource Value}" FontFamily="{StaticResource MonoFont}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="CIDR" Style="{StaticResource Label}" /><TextBlock Text="{Binding CidrText}" Style="{StaticResource Value}" FontFamily="{StaticResource MonoFont}" MaxWidth="520" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="State" Style="{StaticResource Label}" /><TextBlock Text="{Binding Vpc.State}" Style="{StaticResource Value}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Default VPC" Style="{StaticResource Label}" /><TextBlock Text="{Binding Vpc.IsDefault}" Style="{StaticResource Value}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Contains" Style="{StaticResource Label}" />
                    <TextBlock Style="{StaticResource Value}"><TextBlock.Text><MultiBinding StringFormat="{}{0} subnet(s) · {1} interface(s) · {2} security group(s)"><Binding Path="Subnets" /><Binding Path="Interfaces" /><Binding Path="Groups" /></MultiBinding></TextBlock.Text></TextBlock></StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type views:SubnetDetail}">
            <StackPanel>
                <TextBlock Text="{Binding Subnet.Title}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}Subnet · {0} · {1}">
                            <Binding Path="Subnet.VpcId" />
                            <Binding Path="Target.DisplayName" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <WrapPanel Margin="0,0,0,6">
                    <ui:Button Content="Open in console" Icon="{ui:SymbolIcon Open24}" Click="OnOpenConsole" Margin="0,0,6,4" />
                    <ui:Button Content="Copy ID" Icon="{ui:SymbolIcon Copy24}" Click="OnCopyText" Tag="{Binding Subnet.Id}" Margin="0,0,6,4" />
                    <ui:Button Content="Copy CIDR" Icon="{ui:SymbolIcon Copy24}" Click="OnCopyText" Tag="{Binding Subnet.Cidr}" Margin="0,0,6,4" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="CIDR" Style="{StaticResource Label}" /><TextBlock Text="{Binding Subnet.Cidr}" Style="{StaticResource Value}" FontFamily="{StaticResource MonoFont}" /></StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding Subnet.Ipv6Cidrs.Count, Converter={StaticResource CountToVisibility}}">
                    <TextBlock Text="IPv6" Style="{StaticResource Label}" />
                    <ItemsControl ItemsSource="{Binding Subnet.Ipv6Cidrs}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Value}" FontFamily="{StaticResource MonoFont}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Zone" Style="{StaticResource Label}" /><TextBlock Text="{Binding Subnet.AvailabilityZone}" Style="{StaticResource Value}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Kind" Style="{StaticResource Label}" />
                    <TextBlock Text="{Binding Subnet.KindDetail}" Style="{StaticResource Value}" MaxWidth="520" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="Addresses" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    <views:UsageBar Percent="{Binding Subnet.UsedPercent}" Level="{Binding Subnet.UsageLevel}" Width="90" Height="8" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Subnet.UsageText}" Style="{StaticResource Value}" VerticalAlignment="Center" /></StackPanel>

                <TextBlock Text="IP addresses in use" Style="{StaticResource SectionHeader}" />
                <ItemsControl ItemsSource="{Binding Interfaces}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding PrivateIp}" Style="{StaticResource Body}" FontFamily="{StaticResource MonoFont}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Caption}" TextWrapping="Wrap">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} · {1} · {2}">
                                            <Binding Path="Owner" />
                                            <Binding Path="Id" />
                                            <Binding Path="AddressText" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type views:InterfaceDetail}">
            <StackPanel>
                <TextBlock Text="{Binding Interface.PrivateIp}" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextStrong}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6" TextWrapping="Wrap">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}Network interface {0} · {1} · {2}">
                            <Binding Path="Interface.Id" />
                            <Binding Path="Interface.Owner" />
                            <Binding Path="Target.DisplayName" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <WrapPanel Margin="0,0,0,6">
                    <ui:Button Content="Show instance on dashboard" Icon="{ui:SymbolIcon Board24}" Appearance="Primary" Click="OnShowInstance" Tag="{Binding Interface.InstanceId}" Margin="0,0,6,4"
                               Visibility="{Binding HasInstance, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Content="Open in console" Icon="{ui:SymbolIcon Open24}" Click="OnOpenConsole" Margin="0,0,6,4" />
                    <ui:Button Content="Copy IP" Icon="{ui:SymbolIcon Copy24}" Click="OnCopyText" Tag="{Binding Interface.PrivateIp}" Margin="0,0,6,4" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Used by" Style="{StaticResource Label}" /><TextBlock Text="{Binding Interface.Owner}" Style="{StaticResource Value}" MaxWidth="520" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Addresses" Style="{StaticResource Label}" /><TextBlock Text="{Binding Interface.AddressText}" Style="{StaticResource Value}" FontFamily="{StaticResource MonoFont}" MaxWidth="520" /></StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding ElasticIp, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="Elastic IP" Style="{StaticResource Label}" /><TextBlock Text="{Binding ElasticIp.PublicIp}" Style="{StaticResource Value}" FontFamily="{StaticResource MonoFont}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Subnet" Style="{StaticResource Label}" />
                    <TextBlock Style="{StaticResource Value}" MaxWidth="520"><TextBlock.Text><MultiBinding StringFormat="{}{0} ({1}, {2})"><Binding Path="Interface.SubnetId" /><Binding Path="Subnet.Cidr" FallbackValue="?" /><Binding Path="Interface.AvailabilityZone" /></MultiBinding></TextBlock.Text></TextBlock></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Type / status" Style="{StaticResource Label}" />
                    <TextBlock Style="{StaticResource Value}"><TextBlock.Text><MultiBinding StringFormat="{}{0} · {1}"><Binding Path="Interface.InterfaceType" /><Binding Path="Interface.Status" /></MultiBinding></TextBlock.Text></TextBlock></StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding Interface.Description, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="Description" Style="{StaticResource Label}" /><TextBlock Text="{Binding Interface.Description}" Style="{StaticResource Value}" MaxWidth="520" /></StackPanel>
                <TextBlock Text="Security groups" Style="{StaticResource SectionHeader}" />
                <ContentPresenter Content="{Binding Interface.SecurityGroups}" ContentTemplate="{StaticResource GroupChips}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type views:ElasticIpDetail}">
            <StackPanel>
                <TextBlock Text="{Binding Address.PublicIp}" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextStrong}" />
                <TextBlock Text="{Binding Target.DisplayName, StringFormat=Elastic IP · {0}}" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                <WrapPanel Margin="0,0,0,6">
                    <ui:Button Content="Copy IP" Icon="{ui:SymbolIcon Copy24}" Click="OnCopyText" Tag="{Binding Address.PublicIp}" Margin="0,0,6,4" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Name" Style="{StaticResource Label}" /><TextBlock Text="{Binding Address.Name, TargetNullValue='—'}" Style="{StaticResource Value}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Allocation" Style="{StaticResource Label}" /><TextBlock Text="{Binding Address.AllocationId}" Style="{StaticResource Value}" FontFamily="{StaticResource MonoFont}" /></StackPanel>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Attached to" Style="{StaticResource Label}" /><TextBlock Text="{Binding AttachedText}" Style="{StaticResource Value}" MaxWidth="520" /></StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type views:SecurityGroupDetail}">
            <StackPanel>
                <TextBlock Text="{Binding Group.Title}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,0,0,6" TextWrapping="Wrap" />
                <WrapPanel Margin="0,0,0,6">
                    <ui:Button Content="Refresh group" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="OnRefreshGroup" Margin="0,0,6,4"
                               ToolTip="Re-read this group and its rules from AWS now" />
                    <ui:Button Content="Open in console" Icon="{ui:SymbolIcon Open24}" Click="OnOpenConsole" Margin="0,0,6,4" />
                    <ui:Button Content="Copy ID" Icon="{ui:SymbolIcon Copy24}" Click="OnCopyText" Tag="{Binding Group.Id}" Margin="0,0,6,4" />
                </WrapPanel>
                <TextBlock Text="{Binding Group.Description}" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="{Binding Group.Description, Converter={StaticResource NullToCollapsed}}" />

                <DockPanel Margin="0,8,0,2">
                    <ui:Button DockPanel.Dock="Right" Content="Add inbound rule…" Icon="{ui:SymbolIcon Add24}" Padding="8,2" Click="OnAddRule" Tag="in" IsEnabled="{Binding CanEdit}" />
                    <TextBlock Text="Inbound rules" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="No inbound rules: nothing can connect to resources in this group." Style="{StaticResource Caption}"
                           Visibility="{Binding Inbound.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />
                <ContentPresenter Content="{Binding Inbound}" ContentTemplate="{StaticResource RuleRows}" />

                <DockPanel Margin="0,12,0,2">
                    <ui:Button DockPanel.Dock="Right" Content="Add outbound rule…" Icon="{ui:SymbolIcon Add24}" Padding="8,2" Click="OnAddRule" Tag="out" IsEnabled="{Binding CanEdit}" />
                    <TextBlock Text="Outbound rules" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="No outbound rules: resources in this group cannot open connections." Style="{StaticResource Caption}"
                           Visibility="{Binding Outbound.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />
                <ContentPresenter Content="{Binding Outbound}" ContentTemplate="{StaticResource RuleRows}" />
                <TextBlock Text="{Binding EditNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />

                <TextBlock Text="Used by" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="{Binding UsedByText}" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                <ItemsControl ItemsSource="{Binding UsedBy}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding PrivateIp}" Style="{StaticResource Body}" FontFamily="{StaticResource MonoFont}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Caption}" TextWrapping="Wrap">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} · {1}">
                                            <Binding Path="Owner" />
                                            <Binding Path="Id" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Visibility="{Binding ReferencedBy.Count, Converter={StaticResource CountToVisibility}}">
                    <TextBlock Text="Allowed as a source by" Style="{StaticResource SectionHeader}" />
                    <ContentPresenter Content="{Binding ReferencedBy}" ContentTemplate="{StaticResource GroupChips}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <WrapPanel>
            <ui:Button Icon="{ui:SymbolIcon ArrowDownload24}" Content="Download all now" Click="OnDownloadAll" Margin="0,0,14,4"
                       ToolTip="Download VPCs, subnets, interfaces and security groups for every target now" />
            <ui:TextBox x:Name="SearchBox" Width="300" Margin="0,0,10,4" PlaceholderText="Search (Ctrl+F): IP, CIDR, sg-…, eni-…, name, port…"
                        Icon="{ui:SymbolIcon Search24}" TextChanged="OnSearchChanged" KeyDown="OnSearchKeyDown" />
            <ui:Button Content="Collapse all" Click="OnCollapseAll" Margin="0,0,14,4" />
            <TextBlock x:Name="Summary" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,14,0" />
            <TextBlock x:Name="ActionStatus" Style="{StaticResource Body}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="700" />
        </WrapPanel>

        <Grid Grid.Row="1" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" MinWidth="380" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="5*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Panel}" Padding="4">
                <TreeView x:Name="Tree" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextNormal}" Padding="0,0,16,14"
                          SelectedItemChanged="OnSelected" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type views:DashNode}" ItemsSource="{Binding Children}">
                            <Grid Margin="0,1" Opacity="{Binding TitleOpacity}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Style="{StaticResource LevelDot}" Fill="{Binding Level, Converter={StaticResource LevelToBrush}}" />
                                <TextBlock Grid.Column="1" x:Name="TitleText" Text="{Binding Title}" Foreground="{StaticResource TextStrong}" FontSize="12" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Right}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    <ItemsControl ItemsSource="{Binding Gauges}" Focusable="False">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    <views:UsageBar Percent="{Binding Percent}" Level="{Binding Level}" Width="40" Height="5" Margin="0,0,5,0"
                                                                    Visibility="{Binding HasBar, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Text="{Binding Text}" Style="{StaticResource Caption}" Foreground="{StaticResource TextNormal}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="560" />
                            </Grid>
                            <HierarchicalDataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsStrong}" Value="True">
                                    <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                    <Setter TargetName="TitleText" Property="Foreground" Value="#FF60CDFF" />
                                    <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </HierarchicalDataTemplate.Triggers>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ContentControl x:Name="Details" Foreground="{StaticResource TextNormal}" Focusable="False" Margin="0,0,18,0">
                        <TextBlock Text="Select a VPC, subnet, IP address or security group." Style="{StaticResource Body}" />
                    </ContentControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
