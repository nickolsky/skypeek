<UserControl x:Class="Skypeek.App.Views.RequestLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Margin="0,0,0,6">
            <ui:TextBox x:Name="Filter" PlaceholderText="Filter (profile, region, service, operation, parameters, error)…" Width="420"
                        Icon="{ui:SymbolIcon Filter24}" TextChanged="OnFilterChanged" ClearButtonEnabled="True" />
            <CheckBox x:Name="ProblemsOnly" Content="Errors / blocked / skipped only" Margin="12,0,0,0" Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
            <CheckBox x:Name="ElevatedOnly" Content="Elevated key only" Margin="12,0,0,0" Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
            <CheckBox x:Name="Follow" Content="Live" IsChecked="True" Margin="12,0,0,0" />
        </WrapPanel>

        <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" FontSize="12"
                  CanUserAddRows="False" EnableRowVirtualization="True" HorizontalScrollBarVisibility="Auto" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimestampLocal, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="140" />
                <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="80" />
                <DataGridTextColumn Header="Key" Binding="{Binding KeyLabel}" Width="80" />
                <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" Width="230" />
                <DataGridTextColumn Header="Region" Binding="{Binding Region}" Width="90" />
                <DataGridTextColumn Header="Service" Binding="{Binding Service}" Width="110" />
                <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="190" />
                <DataGridTextColumn Header="Parameters" Binding="{Binding Parameters}" Width="240" />
                <DataGridTextColumn Header="HTTP" Binding="{Binding HttpStatus}" Width="55" />
                <DataGridTextColumn Header="ms" Binding="{Binding DurationMs}" Width="55" />
                <DataGridTextColumn Header="Error" Binding="{Binding ErrorCode}" Width="170" />
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="400" />
                <DataGridTextColumn Header="Request ID" Binding="{Binding RequestId}" Width="140" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Margin="2,6,0,0" Style="{StaticResource Caption}"
                   Text="Every AWS call is logged here. Values, credentials, headers and response bodies are never recorded." />
    </Grid>
</UserControl>
