<UserControl x:Class="Skypeek.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,8,0,3" />
        </Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource Body}" />
    </UserControl.Resources>
    <Grid Margin="0,4,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl>
            <!-- ================= Targets ================= -->
            <TabItem Header="Accounts &amp; regions">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel>
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource Panel}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Add targets" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                                <DockPanel>
                                    <CheckBox x:Name="NewShowAll" DockPanel.Dock="Right" Content="All profiles" VerticalAlignment="Bottom"
                                              ToolTip="Also list profiles whose role is not read-only (e.g. AdministratorAccess)" />
                                    <TextBlock Text="Read-only profile" Style="{StaticResource FieldLabel}" />
                                </DockPanel>
                                <ComboBox x:Name="NewProfile" SelectionChanged="OnNewProfileChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" />
                                                <TextBlock Text="  · SSO" Foreground="{StaticResource TextMuted}"
                                                           Visibility="{Binding IsSso, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="  ⚠ not a read-only role" Foreground="#FFFFB86B"
                                                           Visibility="{Binding IsReadOnly, Converter={StaticResource InverseBoolToVisibility}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="Elevated profile (optional, used on demand after approval)" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="NewElevated" DisplayMemberPath="Label" />
                                <TextBlock Text="Regions (select one or more)" Style="{StaticResource FieldLabel}" />
                                <ListBox x:Name="NewRegions" SelectionMode="Multiple" Height="120" Background="Transparent" Foreground="{StaticResource TextNormal}" />
                                <ui:Button Content="Add selected" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="OnAddTargets" />
                            </StackPanel>
                        </Border>
                        <DockPanel DockPanel.Dock="Top">
                            <ui:Button DockPanel.Dock="Right" Content="Remove" Icon="{ui:SymbolIcon Delete24}" Click="OnRemoveTarget" />
                            <TextBlock Text="Targets" Style="{StaticResource SectionHeader}" Margin="0,4,0,6" />
                        </DockPanel>
                        <ListBox x:Name="TargetList" SelectionChanged="OnTargetSelected" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,1">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                                        <TextBlock Style="{StaticResource Caption}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} · {1}">
                                                    <Binding Path="ProfileName" />
                                                    <Binding Path="Region" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="Editor" IsEnabled="False" Margin="0,0,18,0">
                            <TextBlock Text="Target" Style="{StaticResource SectionHeader}" Margin="0,4,0,0" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Alias" Style="{StaticResource FieldLabel}" />
                                    <ui:TextBox x:Name="Alias" PlaceholderText="e.g. US, EU, QA" TextChanged="OnEditorChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Region" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="Region" IsEditable="True" SelectionChanged="OnEditorChanged" LostFocus="OnEditorChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Enabled" Style="{StaticResource FieldLabel}" />
                                    <ui:ToggleSwitch x:Name="TargetEnabled" Checked="OnEditorChanged" Unchecked="OnEditorChanged" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Keys" Style="{StaticResource SectionHeader}" />
                            <TextBlock x:Name="ProfileText" Style="{StaticResource Body}" TextWrapping="Wrap" />
                            <TextBlock Text="Elevated profile — used only when you ask (e.g. to read a secret the read-only role cannot), with a permission prompt every time"
                                       Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                            <ComboBox x:Name="ElevatedProfile" DisplayMemberPath="Label" SelectionChanged="OnElevatedChanged" MaxWidth="460" HorizontalAlignment="Left" MinWidth="340" />
                            <CheckBox x:Name="ElevatedForAll" Content="Use the same elevated profile for every target with this read-only profile" Margin="0,6,0,0" IsChecked="True" />

                            <TextBlock Text="Features" Style="{StaticResource FieldLabel}" />
                            <WrapPanel>
                                <CheckBox x:Name="FeatSecrets" Content="Secrets Manager list" Margin="0,0,16,0" Checked="OnEditorChanged" Unchecked="OnEditorChanged" />
                                <CheckBox x:Name="FeatParams" Content="Parameter Store list" Margin="0,0,16,0" Checked="OnEditorChanged" Unchecked="OnEditorChanged" />
                                <CheckBox x:Name="FeatEb" Content="Elastic Beanstalk health" Margin="0,0,16,0" Checked="OnEditorChanged" Unchecked="OnEditorChanged" />
                                <CheckBox x:Name="FeatEcs" Content="ECS health" Margin="0,0,16,0" Checked="OnEditorChanged" Unchecked="OnEditorChanged" />
                                <CheckBox x:Name="FeatRds" Content="RDS databases" Margin="0,0,16,0" Checked="OnEditorChanged" Unchecked="OnEditorChanged" />
                                <CheckBox x:Name="FeatCache" Content="ElastiCache (Redis/Valkey)" Checked="OnEditorChanged" Unchecked="OnEditorChanged" />
                            </WrapPanel>

                            <TextBlock Text="Schedules" Style="{StaticResource SectionHeader}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Secrets/parameters list refresh" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                    <ComboBox x:Name="CatalogInterval" Width="150" DisplayMemberPath="Label" SelectionChanged="OnEditorChanged" />
                                    <ui:TextBox x:Name="CatalogCustom" Width="130" Margin="8,0,0,0" PlaceholderText="custom minutes" TextChanged="OnEditorChanged" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Health poll (EB, ECS, RDS, cache)" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="HealthInterval" Width="150" HorizontalAlignment="Left" Margin="0,3" DisplayMemberPath="Label" SelectionChanged="OnEditorChanged" />
                                <TextBlock Grid.Row="2" Text="Metrics &amp; alarms" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                    <ComboBox x:Name="MetricsInterval" Width="150" DisplayMemberPath="Label" SelectionChanged="OnEditorChanged" />
                                    <TextBlock x:Name="CostEstimate" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="330" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Threshold overrides for this target" Style="{StaticResource SectionHeader}" />
                            <CheckBox x:Name="OverrideEcs" Content="Override ECS thresholds" Checked="OnEditorChanged" Unchecked="OnEditorChanged" />
                            <StackPanel x:Name="EcsOverridePanel" Orientation="Horizontal" Margin="24,4,0,8">
                                <TextBlock Text="CPU warn/crit" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ui:TextBox x:Name="EcsCpuWarn" Width="64" TextChanged="OnEditorChanged" />
                                <ui:TextBox x:Name="EcsCpuCrit" Width="64" Margin="4,0,16,0" TextChanged="OnEditorChanged" />
                                <TextBlock Text="Memory warn/crit" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ui:TextBox x:Name="EcsMemWarn" Width="64" TextChanged="OnEditorChanged" />
                                <ui:TextBox x:Name="EcsMemCrit" Width="64" Margin="4,0,0,0" TextChanged="OnEditorChanged" />
                            </StackPanel>
                            <CheckBox x:Name="OverrideEb" Content="Override Elastic Beanstalk / EC2 thresholds" Checked="OnEditorChanged" Unchecked="OnEditorChanged" />
                            <StackPanel x:Name="EbOverridePanel" Orientation="Horizontal" Margin="24,4,0,8">
                                <TextBlock Text="CPU warn/crit" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ui:TextBox x:Name="EbCpuWarn" Width="64" TextChanged="OnEditorChanged" />
                                <ui:TextBox x:Name="EbCpuCrit" Width="64" Margin="4,0,16,0" TextChanged="OnEditorChanged" />
                                <TextBlock Text="Memory warn/crit" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ui:TextBox x:Name="EbMemWarn" Width="64" TextChanged="OnEditorChanged" />
                                <ui:TextBox x:Name="EbMemCrit" Width="64" Margin="4,0,0,0" TextChanged="OnEditorChanged" />
                            </StackPanel>
                            <TextBlock x:Name="EditorError" Foreground="#FFFF7B7F" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,6,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ================= Alarms ================= -->
            <TabItem Header="Suppressions &amp; thresholds">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,18,0">
                        <TextBlock Text="Suppressed alarms" Style="{StaticResource SectionHeader}" />
                        <CheckBox x:Name="IgnoreTargetTracking" Content="Ignore auto-scaling target-tracking alarms (TargetTracking-*)" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="24,2,0,8"
                                   Text="These alarms are created by Application Auto Scaling and stay in ALARM whenever a service is scaled in or out. They drive scaling and are not health problems." />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Suppressed alarms stay visible (greyed out) in the dashboard, but never count as problems, never turn the tray icon red and never notify. Use * and ? wildcards." />
                        <WrapPanel Margin="0,8,0,6">
                            <ui:TextBox x:Name="NewPattern" Width="320" PlaceholderText="e.g. *CPUUtilizationLow" FontFamily="{StaticResource MonoFont}" />
                            <ComboBox x:Name="NewPatternScope" Width="200" Margin="8,0,0,0" DisplayMemberPath="Label" />
                            <ui:Button Content="Add" Icon="{ui:SymbolIcon Add24}" Margin="8,0,0,0" Click="OnAddSuppression" />
                            <ui:Button Content="Remove selected" Margin="8,0,0,0" Click="OnRemoveSuppression" />
                        </WrapPanel>
                        <ListView x:Name="SuppressionList" Height="170" Background="Transparent">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Pattern}" Width="360" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextStrong}" />
                                        <TextBlock Text="{Binding Scope}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <DockPanel Margin="0,14,0,0">
                            <ui:Button DockPanel.Dock="Right" Content="Remove selected" Click="OnRemoveCauseSuppression" VerticalAlignment="Bottom" />
                            <TextBlock Text="Suppressed Elastic Beanstalk health causes (add them from the dashboard)" Style="{StaticResource SectionHeader}" />
                        </DockPanel>
                        <ListView x:Name="CauseSuppressionList" Height="140" Background="Transparent">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Pattern}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextStrong}" TextWrapping="Wrap" MaxWidth="760" />
                                        <TextBlock Text="{Binding Scope}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Text="Default thresholds (percent)" Style="{StaticResource SectionHeader}" Margin="0,16,0,4" />
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="84" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="1" Text="CPU warn" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="2" Text="CPU crit" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="4" Text="Mem warn" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Column="5" Text="Mem crit" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Row="1" Text="ECS services" VerticalAlignment="Center" />
                            <ui:TextBox Grid.Row="1" Grid.Column="1" x:Name="GEcsCpuWarn" Margin="0,3,6,3" />
                            <ui:TextBox Grid.Row="1" Grid.Column="2" x:Name="GEcsCpuCrit" Margin="0,3,6,3" />
                            <ui:TextBox Grid.Row="1" Grid.Column="4" x:Name="GEcsMemWarn" Margin="0,3,6,3" />
                            <ui:TextBox Grid.Row="1" Grid.Column="5" x:Name="GEcsMemCrit" Margin="0,3,6,3" />
                            <TextBlock Grid.Row="2" Text="EB (EC2 instances)" VerticalAlignment="Center" />
                            <ui:TextBox Grid.Row="2" Grid.Column="1" x:Name="GEbCpuWarn" Margin="0,3,6,3" />
                            <ui:TextBox Grid.Row="2" Grid.Column="2" x:Name="GEbCpuCrit" Margin="0,3,6,3" />
                            <ui:TextBox Grid.Row="2" Grid.Column="4" x:Name="GEbMemWarn" Margin="0,3,6,3" />
                            <ui:TextBox Grid.Row="2" Grid.Column="5" x:Name="GEbMemCrit" Margin="0,3,6,3" />
                            <TextBlock Grid.Row="3" Text="RDS (mem = connections % of max)" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ui:TextBox Grid.Row="3" Grid.Column="1" x:Name="GRdsCpuWarn" Margin="0,3,6,3" />
                            <ui:TextBox Grid.Row="3" Grid.Column="2" x:Name="GRdsCpuCrit" Margin="0,3,6,3" />
                            <ui:TextBox Grid.Row="3" Grid.Column="4" x:Name="GRdsConnWarn" Margin="0,3,6,3" />
                            <ui:TextBox Grid.Row="3" Grid.Column="5" x:Name="GRdsConnCrit" Margin="0,3,6,3" />
                            <TextBlock Grid.Row="4" Text="RDS storage used" VerticalAlignment="Center" />
                            <ui:TextBox Grid.Row="4" Grid.Column="1" x:Name="GRdsStorageWarn" Margin="0,3,6,3" />
                            <ui:TextBox Grid.Row="4" Grid.Column="2" x:Name="GRdsStorageCrit" Margin="0,3,6,3" />
                            <TextBlock Grid.Row="5" Text="ElastiCache (engine CPU)" VerticalAlignment="Center" />
                            <ui:TextBox Grid.Row="5" Grid.Column="1" x:Name="GCacheCpuWarn" Margin="0,3,6,3" />
                            <ui:TextBox Grid.Row="5" Grid.Column="2" x:Name="GCacheCpuCrit" Margin="0,3,6,3" />
                            <ui:TextBox Grid.Row="5" Grid.Column="4" x:Name="GCacheMemWarn" Margin="0,3,6,3" />
                            <ui:TextBox Grid.Row="5" Grid.Column="5" x:Name="GCacheMemCrit" Margin="0,3,6,3" />
                        </Grid>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="EC2 memory needs the CloudWatch agent (CWAgent mem_used_percent); otherwise it shows n/a. RDS max_connections comes from the parameter group, or is estimated from the engine default and instance size; when unknown, connections are shown but not evaluated." />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Sustained minutes before a breach counts" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox x:Name="SustainedMinutes" Width="110" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Show alarms that fired within (hours)" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox x:Name="AlarmHours" Width="110" HorizontalAlignment="Left" />
                            </StackPanel>
                        </StackPanel>

                        <DockPanel Margin="0,14,0,0">
                            <ui:Button DockPanel.Dock="Right" Content="Remove selected" Click="OnRemoveOverride" VerticalAlignment="Bottom" />
                            <TextBlock Text="Per-service / per-environment overrides (set from the dashboard)" Style="{StaticResource SectionHeader}" />
                        </DockPanel>
                        <ListView x:Name="OverrideList" Height="150" Background="Transparent">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Label}" Width="380" Foreground="{StaticResource TextStrong}" />
                                        <TextBlock Text="{Binding Values}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= General ================= -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,0,0" MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="Global hotkey (press the combination in the box)" Style="{StaticResource FieldLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBox x:Name="HotkeyBox" Width="220" IsReadOnly="True" PreviewKeyDown="OnHotkeyKeyDown" />
                            <TextBlock x:Name="HotkeyStatus" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Free on this machine when checked: Win+Alt+A (default), Ctrl+Alt+Shift+A, Win+Alt+Q. Avoid Ctrl+Shift+letter (IDE/browser shortcuts)." />

                        <ui:ToggleSwitch x:Name="RunOnStartup" Content="Start with Windows (in the tray)" Margin="0,14,0,0" />

                        <TextBlock Text="Lock the UI after this many idle minutes (0 = never). Background refresh keeps running." Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                        <ui:TextBox x:Name="LockoutMinutes" Width="110" HorizontalAlignment="Left" />
                        <CheckBox x:Name="LockOnWindowsLock" Content="Also lock when Windows is locked (Win+L)" Margin="0,8,0,0" />

                        <CheckBox x:Name="WarningsRed" Content="Warning-level problems also turn the tray icon red" Margin="0,14,0,0" />

                        <TextBlock Text="Request log retention (days)" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox x:Name="RetentionDays" Width="110" HorizontalAlignment="Left" />

                        <CheckBox x:Name="ShowNonReadOnly" Content="Allow non-read-only profiles as the read-only key" Margin="0,14,0,0" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="24,2,0,0"
                                   Text="Background refresh would then run with admin credentials. Prefer a ReadOnly profile plus an elevated profile used on demand." />

                        <TextBlock x:Name="CredentialsPath" Style="{StaticResource Caption}" Margin="0,18,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Security ================= -->
            <TabItem Header="Security">
                <StackPanel Margin="0,8,0,0" MaxWidth="400" HorizontalAlignment="Left">
                    <TextBlock Text="Change master password" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="Current password" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="CurrentPassword" />
                    <TextBlock Text="New password (8+ characters)" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="NewPassword" />
                    <TextBlock Text="Confirm new password" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="ConfirmPassword" />
                    <ui:Button Content="Change password" Margin="0,10,0,0" Click="OnChangePassword" />
                    <TextBlock x:Name="PasswordStatus" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock x:Name="VaultPath" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,18,0,0" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <TextBlock x:Name="SaveStatus" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="700" HorizontalAlignment="Left" />
            <ui:Button Content="Save" Appearance="Primary" MinWidth="100" HorizontalAlignment="Right" Click="OnSave" />
        </Grid>
    </Grid>
</UserControl>
