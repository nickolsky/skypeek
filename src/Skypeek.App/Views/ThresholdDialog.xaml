<ui:FluentWindow x:Class="Skypeek.App.Views.ThresholdDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Thresholds" Width="440" SizeToContent="Height" ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <StackPanel>
        <ui:TitleBar Title="Thresholds for this resource" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Margin="20,4,20,20">
            <TextBlock x:Name="ResourceText" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="Overrides the target and global thresholds (percent)." Style="{StaticResource Caption}" Margin="0,2,0,12" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="1" Text="Warning" Style="{StaticResource Caption}" />
                <TextBlock Grid.Column="3" Text="Critical" Style="{StaticResource Caption}" />
                <TextBlock x:Name="CpuLabel" Grid.Row="1" Text="CPU" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ui:TextBox x:Name="CpuWarn" Grid.Row="1" Grid.Column="1" Margin="0,4" />
                <ui:TextBox x:Name="CpuCrit" Grid.Row="1" Grid.Column="3" Margin="0,4" />
                <TextBlock x:Name="MemLabel" Grid.Row="2" Text="Memory" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ui:TextBox x:Name="MemWarn" Grid.Row="2" Grid.Column="1" Margin="0,4" />
                <ui:TextBox x:Name="MemCrit" Grid.Row="2" Grid.Column="3" Margin="0,4" />
            </Grid>
            <TextBlock x:Name="Error" Foreground="#E8464A" Visibility="Collapsed" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button x:Name="ClearButton" Content="Remove override" Margin="0,0,8,0" Click="OnClear" />
                <ui:Button Content="Cancel" Margin="0,0,8,0" Click="OnCancel" />
                <ui:Button Content="Save" Appearance="Primary" Click="OnSave" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
