<ui:FluentWindow x:Class="Skypeek.App.Views.UnlockWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Skypeek"
                 Width="420" SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 Topmost="True"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <StackPanel>
        <ui:TitleBar Title="Skypeek" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Margin="24,8,24,24">
            <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" Text="Unlock" />
            <TextBlock x:Name="Explanation" Margin="0,6,0,16" TextWrapping="Wrap" Style="{StaticResource Caption}" />

            <TextBlock Text="Master password" Style="{StaticResource Caption}" Margin="0,0,0,4" />
            <PasswordBox x:Name="Password" KeyDown="OnKeyDown" />
            <TextBlock x:Name="ConfirmLabel" Text="Confirm master password" Style="{StaticResource Caption}" Margin="0,10,0,4" />
            <PasswordBox x:Name="Confirm" KeyDown="OnKeyDown" />

            <TextBlock x:Name="Error" Margin="0,10,0,0" Foreground="#E8464A" TextWrapping="Wrap" Visibility="Collapsed" />

            <Grid Margin="0,18,0,0">
                <ui:HyperlinkButton x:Name="ResetLink" Content="Forgot password? Reset vault" Padding="0" HorizontalAlignment="Left" Click="OnReset" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:ProgressRing x:Name="Busy" IsIndeterminate="True" Width="20" Height="20" Margin="0,0,10,0" Visibility="Collapsed" />
                    <ui:Button x:Name="Submit" Appearance="Primary" Content="Unlock" MinWidth="110" Click="OnSubmit" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
