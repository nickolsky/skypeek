<UserControl x:Class="Skypeek.App.Views.UsagePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:Skypeek.App.Views">
    <Border Style="{StaticResource Panel}" Margin="0,8,0,8">
        <StackPanel>
            <DockPanel>
                <ui:Button x:Name="AnalyzeButton" DockPanel.Dock="Right" Content="Analyze last 30 days" Icon="{ui:SymbolIcon DataHistogram24}"
                           Padding="8,2" Click="OnAnalyze" VerticalAlignment="Top" />
                <TextBlock Text="Usage (last 30 days)" Style="{StaticResource SectionHeader}" Margin="0,0,0,2" />
            </DockPanel>
            <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap"
                       Text="Reads hourly CPU and memory history from CloudWatch: average, min, max, how often it hits 100%, and whether it looks under- or over-provisioned." />

            <StackPanel x:Name="ResultPanel" Visibility="Collapsed" Margin="0,6,0,0">
                <Border x:Name="VerdictBadge" Style="{StaticResource Badge}" HorizontalAlignment="Left" Padding="8,2">
                    <TextBlock x:Name="VerdictText" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" />
                </Border>
                <TextBlock x:Name="ReasonsText" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,4,0,8" />
                <ItemsControl x:Name="SeriesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Scope}" Style="{StaticResource Body}" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Scope}" />
                                <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource Body}" />
                                <views:UsageBar Grid.Column="2" Percent="{Binding P95}" Level="{Binding Level}" Width="64" Height="6" HorizontalAlignment="Left"
                                                ToolTip="p95 of hourly averages" />
                                <TextBlock Grid.Column="3" Text="{Binding StatsText}" Style="{StaticResource Body}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding PeaksText}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="RangeText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
