<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Skypeek.Desktop.Views"
             x:Class="Skypeek.Desktop.App"
             Name="Skypeek"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Skypeek/Themes/Windows11Resources.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Compact UI: Fluent controls read their font size from this key (default 14). -->
            <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>

            <!-- High-contrast text used explicitly in templates. -->
            <SolidColorBrush x:Key="TextStrong" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextNormal" Color="#FFEDEDED" />
            <SolidColorBrush x:Key="TextMuted" Color="#FFC4C4C4" />
            <SolidColorBrush x:Key="TextDim" Color="#FF8F8F8F" />
            <SolidColorBrush x:Key="PanelBackground" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="PanelBorder" Color="#2EFFFFFF" />
            <SolidColorBrush x:Key="WindowBackground" Color="#FF202020" />

            <views:LevelToBrushConverter x:Key="LevelToBrush" />
            <views:NotEmptyConverter x:Key="NotEmpty" />
            <views:CountConverter x:Key="HasItems" />
            <views:CountConverter x:Key="NoItems" Invert="True" />
            <views:LocalTimeConverter x:Key="LocalTime" />

            <FontFamily x:Key="MonoFont">Consolas, Cascadia Mono, Menlo, SF Mono, DejaVu Sans Mono, Liberation Mono, Ubuntu Mono, monospace</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://Skypeek/Themes/Windows11.axaml" />

        <Style Selector="Window">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextNormal}" />
        </Style>

        <Style Selector="TextBlock.caption">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="TextBlock.body">
            <Setter Property="Foreground" Value="{StaticResource TextNormal}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,4" />
            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
        </Style>
        <!-- Detail rows: "label" is a fixed-width caption, "value" wrapping body text. -->
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Width" Value="110" />
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="Foreground" Value="{StaticResource TextNormal}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#33FFFFFF" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{StaticResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="Ellipse.dot">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Buttons: padding like WPF-UI; danger (red) and caution (amber) for actions that change AWS. -->
        <Style Selector="Button">
            <Setter Property="Padding" Value="11,5,11,6" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#FFC42B1C" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFD83B2C" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.caution">
            <Setter Property="Background" Value="#FF8A5A00" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.caution:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFA06A00" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.transparent">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- WPF stretches combo boxes to their column; Fluent sizes them to content. -->
        <Style Selector="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="DataGrid">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="RowHeight" Value="24" />
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="24" />
        </Style>

        <Style Selector="ToolTip">
            <Setter Property="MaxWidth" Value="480" />
        </Style>
    </Application.Styles>
</Application>
