<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cross-platform desktop app (Avalonia): Windows, macOS and Linux.
    On Windows the Windows target is built (native toast notifications); elsewhere, or with -p:Portable=true, the
    portable net10.0 target (e.g. to publish for macOS or Linux from Windows: -p:Portable=true -r osx-arm64).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(Portable)' != 'true'">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.17763.0</SupportedOSPlatformVersion>
    <AssemblyName>Skypeek</AssemblyName>
    <RootNamespace>Skypeek.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Skypeek.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <!-- Bindings in XAML resolve by reflection, like WPF (DataTemplates are chosen by payload type at run time). -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <!-- Views take the session in their constructor by design (no XAML designer/runtime loader use). -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <!-- Self-contained builds (Linux, macOS) carry the runtime: compress it (about half the size). -->
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="FluentIcons.Avalonia" Version="2.1.343" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <!-- The toolkit pulls System.Drawing.Common 4.7.0 (known vulnerability); use the current one. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- Skia and HarfBuzz ship ~100 MB of native debug symbols; keep them out of the published app. -->
  <Target Name="DropDebugSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Skypeek.Aws\Skypeek.Aws.csproj" />
    <ProjectReference Include="..\Skypeek.Core\Skypeek.Core.csproj" />
    <ProjectReference Include="..\Skypeek.Storage\Skypeek.Storage.csproj" />
  </ItemGroup>

</Project>
