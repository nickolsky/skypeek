<views:DialogWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="using:Skypeek.Desktop.Views"
                    x:Class="Skypeek.Desktop.Views.ConfirmDialog"
                    Title="Skypeek" Width="420" SizeToContent="Height" CanResize="False"
                    ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="#FF2B2B2B">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#FF202020" BorderBrush="#FF3D3D3D" BorderThickness="0,1,0,0" Padding="20,16">
            <Grid ColumnDefinitions="*,8,*">
                <Button x:Name="OkButton" Grid.Column="0" Content="OK" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="accent" IsDefault="True" Click="OnOk" />
                <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsCancel="True" Click="OnCancel" />
            </Grid>
        </Border>

        <StackPanel Margin="20,18,20,22">
            <TextBlock x:Name="HeadingText" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText" Classes="body" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="18" />
        </StackPanel>
    </DockPanel>
</views:DialogWindow>
