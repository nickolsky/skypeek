<Window x:Class="Skypeek.Desktop.Views.MainWindow"
                 xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 Title="Skypeek"
                 Width="1400" Height="860" MinWidth="900" MinHeight="520"
                 FontSize="12"
                 Foreground="{StaticResource TextNormal}"
                 WindowStartupLocation="CenterScreen"
                
                
                
        xmlns:views="using:Skypeek.Desktop.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Grid.Row="1" Margin="12,8,12,10" SelectionChanged="OnTabChanged">
            <TabItem x:Name="DashboardTab" Header="Dashboard" />
            <TabItem x:Name="LogsTab" Header="Logs" />
            <TabItem x:Name="NetworkTab" Header="Network" />
            <TabItem x:Name="CatalogTab" Header="Secrets &amp; parameters" />
            <TabItem x:Name="LogTab" Header="Request log" />
            <TabItem x:Name="SettingsTab" Header="Settings" />
        </TabControl>

        <!-- Top-right of the tab strip. Closing the window only hides it to the tray; Exit really quits. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,16,0">
            <views:IconButton Content="Lock" Symbol="LockClosed" Padding="10,4" Margin="0,0,6,0" Click="OnLock"
                       ToolTip.Tip="Hide the window and require the master password; background refresh continues" />
            <views:IconButton Content="Exit" Symbol="Power" Padding="10,4" Click="OnExit"
                       ToolTip.Tip="Quit Skypeek (stops background monitoring)" />
        </StackPanel>
    </Grid>
</Window>
