<views:DialogWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="using:Skypeek.Desktop.Views"
                    x:Class="Skypeek.Desktop.Views.SecretEditorDialog"
                    Title="Skypeek" Width="640" SizeToContent="Height" MaxHeight="820" CanResize="False"
                    ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="#FF2B2B2B">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#FF202020" BorderBrush="#FF3D3D3D" BorderThickness="0,1,0,0" Padding="20,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <views:IconButton Content="Cancel" Symbol="Dismiss" IsCancel="True" Click="OnCancel" />
                    <views:IconButton x:Name="SaveButton" Classes="caution" Content="Continue…" Symbol="Save" Click="OnSave" />
                </StackPanel>
                <TextBlock Classes="caption" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                           Text="Next: the permission dialog asks you to approve the change with the elevated key. The value is never shown there, logged or stored." />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,16">
                <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" TextWrapping="Wrap" />
                <TextBlock x:Name="SubHeading" Classes="caption" TextWrapping="Wrap" Margin="0,2,0,10" />

                <StackPanel x:Name="CreateFields" IsVisible="False">
                    <TextBlock Classes="field" Text="Target" />
                    <ComboBox x:Name="TargetBox" DisplayMemberBinding="{Binding DisplayName}" HorizontalAlignment="Stretch" />
                    <TextBlock Classes="field" Text="Name" />
                    <TextBox x:Name="NameBox" FontFamily="{StaticResource MonoFont}" />
                    <Grid x:Name="ParameterFields" ColumnDefinitions="*,12,*" Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock Classes="field" Text="Type" />
                            <ComboBox x:Name="TypeBox" SelectedIndex="2" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="String" />
                                <ComboBoxItem Content="StringList" />
                                <ComboBoxItem Content="SecureString" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Classes="field" Text="Tier" />
                            <ComboBox x:Name="TierBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Standard (up to 4 KB, free)" Tag="Standard" />
                                <ComboBoxItem Content="Advanced (up to 8 KB, $0.05/month)" Tag="Advanced" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <TextBlock Classes="field" Text="Description (optional)" />
                    <TextBox x:Name="DescriptionBox" />
                    <TextBlock Classes="field" x:Name="KmsLabel" Text="KMS key (optional; empty = the AWS managed key)" />
                    <TextBox x:Name="KmsBox" FontFamily="{StaticResource MonoFont}" PlaceholderText="alias/… or key id / ARN" />
                </StackPanel>

                <DockPanel Margin="0,12,0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                        <views:IconButton x:Name="LoadButton" Content="Load current value" Symbol="ShieldKeyhole" Padding="8,2" Click="OnLoadCurrent" IsVisible="False"
                                          ToolTip.Tip="Reads the current value with the elevated key (asks for approval) so you can change it" />
                        <ToggleButton x:Name="ShowToggle" Content="Show" Padding="8,2" IsCheckedChanged="OnShowChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="section" Text="Value" Margin="0" VerticalAlignment="Center" />
                        <RadioButton x:Name="TextMode" GroupName="mode" Content="Text" IsChecked="True" IsCheckedChanged="OnModeChanged" />
                        <RadioButton x:Name="JsonMode" GroupName="mode" Content="Key / value (JSON)" IsCheckedChanged="OnModeChanged" />
                    </StackPanel>
                </DockPanel>
                <TextBox x:Name="ValueBox" PasswordChar="•" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="260"
                         FontFamily="{StaticResource MonoFont}" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <StackPanel x:Name="JsonPanel" IsVisible="False">
                    <DataGrid x:Name="JsonGrid" AutoGenerateColumns="False" HeadersVisibility="Column" MaxHeight="280" MinHeight="120" CanUserSortColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="200" FontFamily="{StaticResource MonoFont}" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Shown}" Width="*" FontFamily="{StaticResource MonoFont}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                        <views:IconButton Content="Add key" Symbol="Add" Padding="8,2" Click="OnAddRow" />
                        <views:IconButton Content="Remove selected" Symbol="Delete" Padding="8,2" Click="OnRemoveRow" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="ValueInfo" Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock x:Name="Error" Foreground="#FFFF7B7F" TextWrapping="Wrap" Margin="0,8,0,0" IsVisible="False" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</views:DialogWindow>
